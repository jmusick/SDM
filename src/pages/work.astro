---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Web Design Portfolio | Stone Dragon Media"
  description="Explore Stone Dragon Media’s web design portfolio, including Firelands Current, our digital newspaper, artist and author websites, and Tagstash."
  canonical="https://stonedragonmedia.com/work/"
  ogUrl="https://stonedragonmedia.com/work/"
  breadcrumb="Our Work"
  ogImage="https://stonedragonmedia.com/our-work-header.webp"
  ogImageAlt="Stone Dragon Media portfolio — web design and development work"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Web Design Portfolio",
      "url": "https://stonedragonmedia.com/work/",
      "about": [
        {
          "@type": "WebSite",
          "name": "Firelands Current",
          "url": "https://firelandscurrent.com/",
          "description": "Independent digital newspaper for Sandusky, Ohio, and the Firelands region, owned and operated by Stone Dragon Media, LLC. Local news, an events calendar, and reader discussions.",
          "image": "https://stonedragonmedia.com/work/firelands-current.webp",
          "creator": { "@type": "Organization", "name": "Stone Dragon Media, LLC", "url": "https://stonedragonmedia.com/" },
          "publisher": { "@type": "Organization", "name": "Stone Dragon Media, LLC", "url": "https://stonedragonmedia.com/" }
        },
        {
          "@type": "WebSite",
          "name": "JD Musick",
          "url": "https://jdmusick.band/",
          "description": "Album-focused site for blues and soul artist JD Musick, with a full tracklist, streaming links, and booking contact.",
          "image": "https://stonedragonmedia.com/work/jdmusick.webp",
          "creator": { "@type": "Organization", "name": "Stone Dragon Media", "url": "https://stonedragonmedia.com" }
        },
        {
          "@type": "WebSite",
          "name": "Simon Rook",
          "url": "https://simonrook.com/",
          "description": "Author site for Simon Rook, built around the launch of the practical-philosophy book The Stoic Mind for Overthinkers.",
          "image": "https://stonedragonmedia.com/work/simonrook.webp",
          "creator": { "@type": "Organization", "name": "Stone Dragon Media", "url": "https://stonedragonmedia.com" }
        },
        {
          "@type": "WebSite",
          "name": "Dorian Black",
          "url": "https://dorianblack.com/",
          "description": "Launch site for synth-pop artist Dorian Black, built around the debut album After Tonight.",
          "image": "https://stonedragonmedia.com/work/dorianblack.webp",
          "creator": { "@type": "Organization", "name": "Stone Dragon Media", "url": "https://stonedragonmedia.com" }
        },
        {
          "@type": "WebSite",
          "name": "Pneumaris",
          "url": "https://pneumarisband.com/",
          "description": "Atmospheric artist site for the metal project Pneumaris, with streaming links and a dedicated music page.",
          "image": "https://stonedragonmedia.com/work/pneumaris.webp",
          "creator": { "@type": "Organization", "name": "Stone Dragon Media", "url": "https://stonedragonmedia.com" }
        },
        {
          "@type": "WebSite",
          "name": "Tagstash",
          "url": "https://tagsta.sh/",
          "description": "Tag-first bookmarking and resource-organization tool built in house by Stone Dragon Media.",
          "image": "https://stonedragonmedia.com/work/tagstash.webp",
          "creator": { "@type": "Organization", "name": "Stone Dragon Media", "url": "https://stonedragonmedia.com" }
        }
      ]
    })} />
    <style>
      .work-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
      }

      /* The screenshot runs edge to edge, so the card's chamfer cuts the image itself. */
      .work-card {
        display: flex;
        flex-direction: column;
        padding: 0;
        scroll-margin-top: 1.5rem;
      }

      .work-thumb {
        aspect-ratio: 1180 / 615;
        overflow: hidden;
        background: var(--slate);
      }

      .work-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        display: block;
      }

      .work-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 1.4rem 1.6rem 1.6rem;
      }

      .work-body h2 {
        margin: 0 0 0.6rem;
        font-size: clamp(1.3rem, 2vw, 1.6rem);
      }

      .work-body p {
        margin: 0 0 0.9rem;
      }

      .work-body ul {
        margin: 0 0 1.4rem;
        padding-left: 1.1rem;
        color: var(--ink-soft);
      }

      .work-body li {
        margin: 0 0 0.35rem;
        line-height: 1.5;
      }

      .work-body .button {
        align-self: flex-start;
        margin-top: auto;
      }

      @media (max-width: 760px) {
        .work-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="work" />

  <main id="main-content">
    <PageHero
      image="/our-work-header.webp"
      alt="Stone Dragon Media portfolio — web design and development work"
      title="Our Work — Web Design Portfolio"
      desc="See how our websites and applications help people find books and music, follow local news, and organize saved links."
      crumbs={[{ name: "Our Work" }]}
      position="center 35%"
    />

    <div class="page">
      <div class="work-grid">
        <article class="card work-card" id="firelands-current">
          <div class="work-thumb">
            <img src="/work/firelands-current.webp" alt="Firelands Current homepage with its teal masthead and local news headlines" loading="lazy" width="1180" height="615" />
          </div>
          <div class="work-body">
            <h2>Firelands Current</h2>
            <p>
              An independent digital newspaper for Sandusky, Ohio, and the Firelands region.
              We designed and built the site, and Stone Dragon Media, LLC owns and operates
              the publication, from its local coverage to its publishing platform.
            </p>
            <ul>
              <li>Lake Erie-inspired teal palette, condensed headlines, and serif reading text give the publication its own identity</li>
              <li>Readers can find local news by community and section, follow writers, and subscribe through RSS</li>
              <li>Find events in a specific community and add them to a personal calendar</li>
              <li>Discuss each story and event with neighbors through Talk of the Town</li>
              <li>Editors manage stories, events, credited photos, reader tips, and advertising through custom newsroom tools</li>
            </ul>
            <a class="button button-secondary" href="https://firelandscurrent.com/" target="_blank" rel="noreferrer noopener" aria-label="Visit Firelands Current (opens in a new tab)">
              <Icon class="icon" name="lucide:external-link" aria-hidden="true" />
              Visit Firelands Current
            </a>
          </div>
        </article>
        <article class="card work-card" id="jd-musick">
          <div class="work-thumb">
            <img src="/work/jdmusick.webp" alt="JD Musick website showing The Road Still Knows album launch" loading="lazy" width="1180" height="615" />
          </div>
          <div class="work-body">
            <h2>JD Musick</h2>
            <p>
              A website for blues and soul artist JD Musick and the debut record
              <em>The Road Still Knows</em>. Visitors can explore all eleven songs, find the
              album on streaming services, and get in touch about booking or licensing.
            </p>
            <ul>
              <li>Immersive album artwork, artist branding, and listening links lead the home page</li>
              <li>Dedicated music page with the full eleven-song tracklist, runtimes, and song descriptions</li>
              <li>Spotify and Apple Music links make the record easy to find from across the site</li>
              <li>About page and contact form for booking, press, licensing, and collaborations</li>
              <li>Music artist and album markup gives search engines structured details about the release</li>
            </ul>
            <a class="button button-secondary" href="https://jdmusick.band/" target="_blank" rel="noreferrer noopener" aria-label="Visit the JD Musick site (opens in a new tab)">
              <Icon class="icon" name="lucide:external-link" aria-hidden="true" />
              Visit Site
            </a>
          </div>
        </article>
        <article class="card work-card" id="simon-rook">
          <div class="work-thumb">
            <img src="/work/simonrook.webp" alt="Simon Rook author website" loading="lazy" width="1180" height="615" />
          </div>
          <div class="work-body">
            <h2>Simon Rook</h2>
            <p>
              An author website for the launch of <em>The Stoic Mind for Overthinkers</em>.
              Readers can explore the book&rsquo;s chapters and takeaways before following a
              purchase link to Amazon Kindle.
            </p>
            <ul>
              <li>The book cover's navy, bronze, and bone colors give every page a consistent identity</li>
              <li>Add a book in one catalogue file to publish its details, chapter breakdown, reader takeaways, and purchase links together</li>
              <li>Book and author structured data describes each title, its cover, and its format for search engines</li>
              <li>Buy links pointing readers to Amazon Kindle, with slots ready for more stores and author profiles as they open</li>
              <li>Static pages delivered through a global content delivery network, with an automatically generated sitemap</li>
            </ul>
            <a class="button button-secondary" href="https://simonrook.com/" target="_blank" rel="noreferrer noopener" aria-label="Visit the Simon Rook site (opens in a new tab)">
              <Icon class="icon" name="lucide:external-link" aria-hidden="true" />
              Visit Site
            </a>
          </div>
        </article>
        <article class="card work-card" id="dorian-black">
          <div class="work-thumb">
            <img src="/work/dorianblack.webp" alt="Dorian Black synth-pop artist website" loading="lazy" width="1180" height="615" />
          </div>
          <div class="work-body">
            <h2>Dorian Black</h2>
            <p>
              A neon-lit website for synth-pop artist Dorian Black and the debut album
              <em>After Tonight</em>. Listeners can explore the full record and find links to
              Spotify and Apple Music in one place.
            </p>
            <ul>
              <li>Custom neon-and-chrome design system built to match the album’s late-night mood</li>
              <li>Update album art, track listings, runtimes, and liner notes in one file to keep the music page current</li>
              <li>Streaming links to Spotify and Apple Music site-wide, with slots ready for YouTube, SoundCloud, and socials as they go live</li>
              <li>Album and artist structured data describes the release for search engines</li>
              <li>Static pages delivered through a global content delivery network</li>
            </ul>
            <a class="button button-secondary" href="https://dorianblack.com/" target="_blank" rel="noreferrer noopener" aria-label="Visit the Dorian Black site (opens in a new tab)">
              <Icon class="icon" name="lucide:external-link" aria-hidden="true" />
              Visit Site
            </a>
          </div>
        </article>
        <article class="card work-card" id="pneumaris">
          <div class="work-thumb">
            <img src="/work/pneumaris.webp" alt="Pneumaris band website" loading="lazy" width="1180" height="615" />
          </div>
          <div class="work-body">
            <h2>Pneumaris</h2>
            <p>
              A dark, atmospheric website for the metal project Pneumaris. Fans can listen
              through embedded music players, explore releases, and find the band&rsquo;s
              music and social profiles.
            </p>
            <ul>
              <li>Responsive layout designed for phones, tablets, and desktop screens</li>
              <li>Dedicated music page with album art, track listings, and built-in streaming players</li>
              <li>Contact form with spam protection</li>
              <li>One-click links out to all their music and social platforms, with accounts managed by our team</li>
              <li>Built-in visitor analytics to track traffic and engagement</li>
            </ul>
            <a class="button button-secondary" href="https://pneumarisband.com/" target="_blank" rel="noreferrer noopener" aria-label="Visit the Pneumaris site (opens in a new tab)">
              <Icon class="icon" name="lucide:external-link" aria-hidden="true" />
              Visit Site
            </a>
          </div>
        </article>
        <article class="card work-card" id="tagstash">
          <div class="work-thumb">
            <img src="/work/tagstash.webp" alt="Tagstash bookmarking tool" loading="lazy" width="1180" height="615" />
          </div>
          <div class="work-body">
            <h2>Tagstash</h2>
            <p>
              Our own bookmarking application for saving links and finding them again by tag
              or search. We built and operate the web app and its companion Firefox extension.
            </p>
            <ul>
              <li>Organize saved links with tags and search them when you need them</li>
              <li>Free and paid plans with secure online payments</li>
              <li>Secure account sign-up with email verification</li>
              <li>A custom-built Firefox extension for saving pages in a single click, with a sidebar for browsing and tagging</li>
              <li>Shareable public pages so users can showcase their saved links</li>
            </ul>
            <a class="button button-secondary" href="https://tagsta.sh/" target="_blank" rel="noreferrer noopener" aria-label="Visit the Tagstash site (opens in a new tab)">
              <Icon class="icon" name="lucide:external-link" aria-hidden="true" />
              Visit Site
            </a>
          </div>
        </article>
      </div>
      <section class="section">
        <h2 class="section-title">Tell us about your project</h2>
        <p>Have a website or application in mind? Tell us what you need help with and we&rsquo;ll follow up within one business day. Consultations are free.</p>
        <a class="button button-primary" href="/contact/">Discuss Your Project</a>
      </section>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
