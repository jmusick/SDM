---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getUserCount } from "../../lib/users";
import { isSetupEnabled } from "../../lib/setup";
import { PASSWORD_ERRORS, PASSWORD_HINT, PASSWORD_MIN_LENGTH } from "../../lib/password-policy";

export const prerender = false;

if (!isSetupEnabled()) {
  return Astro.redirect("/login");
}

const userCount = await getUserCount(Astro.locals);
if (userCount > 0) {
  return Astro.redirect("/login");
}

const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam === "invalid" ? "Enter a valid email address." : errorParam ? PASSWORD_ERRORS[errorParam] ?? "Please try again." : null;
---

<BaseLayout title="Set Up Admin Account | Stone Dragon Media" robots="noindex, nofollow">
  <Fragment slot="head">
    <style>
      .wrapper {
        max-width: 420px;
        margin: 0 auto;
        padding: 5rem 1.25rem;
      }

      h1 {
        margin: 0 0 0.35rem;
        font-size: 1.7rem;
        color: var(--brand-strong);
        text-align: center;
      }

      .subtitle {
        margin: 0 0 1.3rem;
        color: var(--ink-soft);
        text-align: center;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 0.85rem;
      }

      label {
        font-size: 0.83rem;
        font-weight: 600;
        color: var(--brand-strong);
      }

      input {
        width: 100%;
        border: 1px solid #7d8d9a;
        background: #fff;
        border-radius: 3px;
        padding: 0.7rem 0.8rem;
        font: inherit;
        color: var(--ink);
      }

      .helper {
        margin: 0 0 0.85rem;
        font-size: 0.82rem;
        color: var(--ink-soft);
      }

      .button {
        width: 100%;
        margin-top: 0.3rem;
      }

      .form-status.error {
        margin: 0 0 0.85rem;
        padding: 0.6rem 0.7rem;
        border-radius: 0.62rem;
        font-size: 0.9rem;
        background: rgba(173, 38, 38, 0.12);
        border: 1px solid rgba(173, 38, 38, 0.28);
        color: #7d2121;
      }
    </style>
  </Fragment>

  <main class="wrapper">
    <h1>Set Up Admin Account</h1>
    <p class="subtitle">No admin account exists yet. Create the owner account to get started.</p>

    <div class="card form-card">
      {errorMessage && <div class="form-status error" role="alert">{errorMessage}</div>}
      <form method="post" action="/api/setup/create-admin">
        <div class="field">
          <label for="operatorSecret">Setup authorization secret</label>
          <input id="operatorSecret" name="operatorSecret" type="password" required maxlength="512" autocomplete="off" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" required minlength={PASSWORD_MIN_LENGTH} aria-describedby="password-policy" autocomplete="new-password" />
        </div>
        <p id="password-policy" class="helper">{PASSWORD_HINT}</p>
        <button class="button button-primary" type="submit">Create Admin Account</button>
      </form>
    </div>
  </main>
</BaseLayout>
