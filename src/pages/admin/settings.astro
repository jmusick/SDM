---
import AdminLayout from "../../layouts/AdminLayout.astro";
import SettingsForm from "../../components/SettingsForm.astro";
import { ensureRole } from "../../lib/http";
import { getUserById } from "../../lib/users";
import { PASSWORD_ERRORS } from "../../lib/password-policy";

export const prerender = false;

const guard = ensureRole(Astro, ["admin"]);
if (guard instanceof Response) return guard;

const user = await getUserById(Astro.locals, guard.id);
if (!user) {
  return Astro.redirect("/login");
}

const errorParam = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  invalid_email: "Enter a valid email address.",
  email_taken: "That email is already in use by another account.",
  ...PASSWORD_ERRORS,
  password_mismatch: "New password and confirmation don't match.",
  wrong_password: "Current password is incorrect.",
};
const errorMessage = errorParam ? errorMessages[errorParam] ?? "Something went wrong." : null;

const savedParam = Astro.url.searchParams.get("saved");
const successMessage = savedParam === "password" ? "Password updated." : savedParam === "1" ? "Profile saved." : null;

const noticeMessage =
  Astro.url.searchParams.get("mustchange") === "1"
    ? "Set a new password to continue — your current one is temporary."
    : null;
---

<AdminLayout title="Settings">
  {Astro.locals.session?.impersonatingClientId && (
    <p class="notice">These settings change your own administrator account, not the client you are viewing.
      Exit client view before changing business records.</p>
  )}
  <SettingsForm user={user} backTo="/admin/settings" errorMessage={errorMessage} successMessage={successMessage} noticeMessage={noticeMessage} />
</AdminLayout>
