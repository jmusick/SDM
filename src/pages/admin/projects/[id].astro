---
import { Icon } from "astro-icon/components";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { ensureRole } from "../../../lib/http";
import { getProjectById } from "../../../lib/projects";
import { getClientById } from "../../../lib/clients";
import { listTasksByProject, TASK_LANES, type TaskLane, type TaskType } from "../../../lib/tasks";
import { listNotes } from "../../../lib/notes";
import { listAdminUsers } from "../../../lib/users";
import { listTimeEntriesByTask, getTaskTimeTotalMinutes } from "../../../lib/timeEntries";

export const prerender = false;

const guard = ensureRole(Astro, ["admin"]);
if (guard instanceof Response) return guard;

const { id } = Astro.params;
const project = id ? await getProjectById(Astro.locals, id) : null;
if (!project) {
  return Astro.redirect("/admin/projects");
}

const [client, tasks, notes, admins] = await Promise.all([
  project.clientId ? getClientById(Astro.locals, project.clientId) : Promise.resolve(null),
  listTasksByProject(Astro.locals, project.id),
  listNotes(Astro.locals, "project_notes", project.id),
  listAdminUsers(Astro.locals),
]);

// Notes/time entries for every task are loaded up front (rather than fetched when the modal
// opens) so editing a task never needs a JSON API round trip — the modal just clones the
// matching <template>. Fine at this app's scale; revisit if a project ever has hundreds of tasks.
const taskDetails = new Map(
  await Promise.all(
    tasks.map(async (task) => {
      const [taskNotes, timeEntries, totalMinutes] = await Promise.all([
        listNotes(Astro.locals, "task_notes", task.id),
        listTimeEntriesByTask(Astro.locals, task.id),
        getTaskTimeTotalMinutes(Astro.locals, task.id),
      ]);
      return [task.id, { notes: taskNotes, timeEntries, totalMinutes }] as const;
    })
  )
);

const toDateInput = (ms: number | null) => (ms ? new Date(ms).toISOString().slice(0, 10) : "");
const formatDateTime = (ms: number) => new Date(ms).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" });
// entry_date is stored as UTC midnight (parsed from a plain <input type=date>), so render it
// back in UTC too — otherwise a negative-offset local timezone shifts it a day earlier.
const formatDate = (ms: number) => new Date(ms).toLocaleDateString("en-US", { dateStyle: "medium", timeZone: "UTC" });
const formatMinutes = (m: number) => `${Math.floor(m / 60)}h ${m % 60}m`;

const errorParam = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  invalid: "Project name is required.",
  task_invalid: "A task title is required.",
  note_invalid: "Note text is required.",
  time_invalid: "Enter a valid date and an amount greater than zero.",
};
const errorMessage = errorParam ? (errorMessages[errorParam] ?? null) : null;

const lanes = TASK_LANES;
const laneLabel: Record<TaskLane, string> = {
  planning: "Planning",
  to_do: "To Do",
  in_progress: "In Progress",
  qa: "QA",
  done: "Done",
};
const tasksByLane: Record<TaskLane, typeof tasks> = { planning: [], to_do: [], in_progress: [], qa: [], done: [] };
for (const task of tasks) tasksByLane[task.lane].push(task);

const taskTypeBadge: Record<TaskType, string> = {
  story: "badge-neutral",
  bug: "badge-danger",
  task: "badge-warning",
  chore: "badge-success",
};
---

<AdminLayout title={project.name}>
  {errorMessage && <div class="notice notice-error">{errorMessage}</div>}

  <div class="project-columns">
    <div class="card">
      <p style="margin: 0 0 0.8rem; color: var(--ink-soft);">
        Client: {project.clientId ? <a href={`/admin/clients/${project.clientId}`} style="color: var(--brand-strong); font-weight: 600; text-decoration: none;">{client?.companyName ?? "Unknown"}</a> : <span class="badge badge-internal">Internal</span>}
      </p>
      <form method="post" action="/api/projects/save" id="project-form">
        <input type="hidden" name="projectId" value={project.id} />
        <div class="form-grid">
          <div class="field full">
            <label for="name">Project Name</label>
            <input id="name" name="name" type="text" required value={project.name} />
          </div>
          <div class="field full">
            <label for="description">Description</label>
            <textarea id="description" name="description">{project.description ?? ""}</textarea>
          </div>
          <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="planning" selected={project.status === "planning"}>Planning</option>
              <option value="in_progress" selected={project.status === "in_progress"}>In Progress</option>
              <option value="review" selected={project.status === "review"}>Review</option>
              <option value="on_hold" selected={project.status === "on_hold"}>On Hold</option>
              <option value="completed" selected={project.status === "completed"}>Completed</option>
            </select>
          </div>
          <div class="field">
            <label for="startDate">Start Date</label>
            <input id="startDate" name="startDate" type="date" value={toDateInput(project.startDate)} />
          </div>
          <div class="field">
            <label for="targetDate">Target Date</label>
            <input id="targetDate" name="targetDate" type="date" value={toDateInput(project.targetDate)} />
          </div>
        </div>
      </form>
      <div class="form-actions" style="justify-content: space-between;">
        <button class="btn btn-primary" type="submit" form="project-form">Save Changes</button>
        <form
          method="post"
          action="/api/projects/delete"
          onsubmit="return confirm('Delete this project? This cannot be undone.');"
          style="margin: 0;"
        >
          <input type="hidden" name="projectId" value={project.id} />
          <button class="btn btn-danger" type="submit">
            <Icon class="icon" name="lucide:trash-2" aria-hidden="true" />
            Delete Project
          </button>
        </form>
      </div>
    </div>

    <div class="card" data-note-list>
      <h2 style="margin: 0 0 1rem; font-family: 'Sora', sans-serif; font-size: 1rem; color: var(--brand-strong);">Notes</h2>
      {notes.length === 0 ? (
        <p class="empty-state">No notes yet.</p>
      ) : (
        <div class="thread">
          {notes.map((note) => (
            <div class="thread-message">
              <div class="thread-meta">
                <span>{note.authorName}</span>
                <span>{formatDateTime(note.createdAt)}</span>
              </div>
              <div class="thread-body" data-note-body>{note.body}</div>
              <form method="post" action="/api/project-notes/save" class="note-edit-form" hidden data-note-edit-form>
                <input type="hidden" name="projectId" value={project.id} />
                <input type="hidden" name="noteId" value={note.id} />
                <div class="field">
                  <textarea name="body" required>{note.body}</textarea>
                </div>
                <div class="form-actions">
                  <button class="btn btn-primary" type="submit">Save</button>
                  <button class="btn btn-secondary" type="button" data-cancel-edit>Cancel</button>
                </div>
              </form>
              <div class="form-actions" data-note-actions>
                <button class="btn btn-secondary" type="button" data-edit-note>Edit</button>
                <form method="post" action="/api/project-notes/delete" onsubmit="return confirm('Delete this note?');">
                  <input type="hidden" name="projectId" value={project.id} />
                  <input type="hidden" name="noteId" value={note.id} />
                  <button class="btn btn-danger" type="submit">Delete</button>
                </form>
              </div>
            </div>
          ))}
        </div>
      )}
      <form method="post" action="/api/project-notes/save">
        <input type="hidden" name="projectId" value={project.id} />
        <div class="field">
          <label for="body">Add Note</label>
          <textarea id="body" name="body" required></textarea>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit">Add Note</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card section-gap">
    <div class="header-actions" style="margin-bottom: 1rem; justify-content: space-between;">
      <h2 style="margin: 0; font-family: 'Sora', sans-serif; font-size: 1rem; color: var(--brand-strong);">Tasks</h2>
      <button type="button" class="btn btn-secondary" data-open-task-modal="create">
        <Icon class="icon" name="lucide:plus" aria-hidden="true" />
        Add Task
      </button>
    </div>
    <div class="notice notice-error" data-board-error hidden></div>
    <div class="kanban" data-kanban>
      {lanes.map((lane) => (
        <section class="kanban-column" aria-labelledby={`lane-heading-${lane}`}>
          <h3 class="kanban-column-header" id={`lane-heading-${lane}`}>
            {laneLabel[lane]}
            <span class="kanban-count"><span data-lane-count>{tasksByLane[lane].length}</span><span class="visually-hidden"> tasks</span></span>
          </h3>
          <ul class="kanban-drop-zone" role="list" data-lane-dropzone={lane}>
            {tasksByLane[lane].map((task) => (
              <li
                class="kanban-card"
                draggable="true"
                data-task-id={task.id}
                data-task-title={task.title}
                data-task-description={task.description ?? ""}
                data-task-type={task.type}
                data-task-priority={task.priority}
                data-task-assignee={task.assignedToUserId ?? ""}
              >
                {/* draggable=false so a drag started on the link moves the whole card, not a URL */}
                <a class="kanban-card-link" href={`/admin/projects/${project.id}?openTask=${task.id}`} draggable="false">
                  <span class={`badge ${taskTypeBadge[task.type]}`}>{task.type}</span>
                  <span class="kanban-card-title">{task.title}</span>
                  <span class="kanban-card-footer">
                    <span class={`kanban-priority kanban-priority-${task.priority}`}>{task.priority}<span class="visually-hidden"> priority,</span></span>
                    <span class="kanban-assignee">{task.assignedToName ?? "Unassigned"}</span>
                  </span>
                  <span class="visually-hidden" data-card-lane>, in {laneLabel[lane]}</span>
                </a>
                {/* Keyboard/screen-reader equivalent of drag-and-drop (WCAG 2.1.1) — same endpoint. */}
                <label class="visually-hidden" for={`lane-select-${task.id}`}>Lane for {task.title}</label>
                <select class="kanban-lane-select" id={`lane-select-${task.id}`} data-lane-select>
                  {lanes.map((option) => (
                    <option value={option} selected={option === lane}>{laneLabel[option]}</option>
                  ))}
                </select>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>

  <dialog class="modal" id="task-modal" aria-labelledby="task-modal-heading">
    <div class="modal-header">
      <h2 id="task-modal-heading">Add Task</h2>
      <button type="button" class="modal-close" data-close-modal aria-label="Close">
        <Icon class="icon" name="lucide:x" aria-hidden="true" />
      </button>
    </div>
    <div class="modal-body">
      <form method="post" action="/api/tasks/save" id="task-modal-form">
        <input type="hidden" name="projectId" value={project.id} />
        <input type="hidden" name="taskId" id="task-modal-taskId" value="" />
        <div class="form-grid">
          <div class="field full">
            <label for="task-modal-title">Title</label>
            <input id="task-modal-title" name="title" type="text" required />
          </div>
          <div class="field full">
            <label for="task-modal-description">Description</label>
            <textarea id="task-modal-description" name="description"></textarea>
          </div>
          <div class="field">
            <label for="task-modal-type">Type</label>
            <select id="task-modal-type" name="type">
              <option value="story">Story</option>
              <option value="bug">Bug</option>
              <option value="task">Task</option>
              <option value="chore">Chore</option>
            </select>
          </div>
          <div class="field">
            <label for="task-modal-priority">Priority</label>
            <select id="task-modal-priority" name="priority">
              <option value="low">Low</option>
              <option value="normal">Normal</option>
              <option value="high">High</option>
            </select>
          </div>
          <div class="field">
            <label for="task-modal-assignee">Assignee</label>
            <select id="task-modal-assignee" name="assignedToUserId">
              <option value="">Unassigned</option>
              {admins.map((admin) => (
                <option value={admin.id}>{admin.displayName}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save Task</button>
          <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
        </div>
      </form>

      <div id="task-modal-panels"></div>
    </div>
    <form
      method="post"
      action="/api/tasks/delete"
      id="task-modal-delete-form"
      onsubmit="return confirm('Delete this task? This cannot be undone.');"
      hidden
    >
      <input type="hidden" name="projectId" value={project.id} />
      <input type="hidden" name="taskId" id="task-modal-delete-taskId" value="" />
      <div class="modal-footer">
        <button type="submit" class="btn btn-danger">
          <Icon class="icon" name="lucide:trash-2" aria-hidden="true" />
          Delete Task
        </button>
      </div>
    </form>
  </dialog>

  {tasks.map((task) => {
    const details = taskDetails.get(task.id);
    const taskNotes = details?.notes ?? [];
    const timeEntries = details?.timeEntries ?? [];
    const totalMinutes = details?.totalMinutes ?? 0;
    return (
      <template id={`task-panel-${task.id}`}>
        <div data-note-list>
          <h3 class="modal-section-heading">Notes</h3>
          {taskNotes.length === 0 ? (
            <p class="empty-state">No notes yet.</p>
          ) : (
            <div class="thread">
              {taskNotes.map((note) => (
                <div class="thread-message">
                  <div class="thread-meta">
                    <span>{note.authorName}</span>
                    <span>{formatDateTime(note.createdAt)}</span>
                  </div>
                  <div class="thread-body" data-note-body>{note.body}</div>
                  <form method="post" action="/api/task-notes/save" class="note-edit-form" hidden data-note-edit-form>
                    <input type="hidden" name="projectId" value={project.id} />
                    <input type="hidden" name="taskId" value={task.id} />
                    <input type="hidden" name="noteId" value={note.id} />
                    <div class="field">
                      <textarea name="body" required>{note.body}</textarea>
                    </div>
                    <div class="form-actions">
                      <button class="btn btn-primary" type="submit">Save</button>
                      <button class="btn btn-secondary" type="button" data-cancel-edit>Cancel</button>
                    </div>
                  </form>
                  <div class="form-actions" data-note-actions>
                    <button class="btn btn-secondary" type="button" data-edit-note>Edit</button>
                    <form method="post" action="/api/task-notes/delete" onsubmit="return confirm('Delete this note?');">
                      <input type="hidden" name="projectId" value={project.id} />
                      <input type="hidden" name="taskId" value={task.id} />
                      <input type="hidden" name="noteId" value={note.id} />
                      <button class="btn btn-danger" type="submit">Delete</button>
                    </form>
                  </div>
                </div>
              ))}
            </div>
          )}
          <form method="post" action="/api/task-notes/save">
            <input type="hidden" name="projectId" value={project.id} />
            <input type="hidden" name="taskId" value={task.id} />
            <div class="field">
              <label>Add Note</label>
              <textarea name="body" required></textarea>
            </div>
            <div class="form-actions">
              <button class="btn btn-primary" type="submit">Add Note</button>
            </div>
          </form>
        </div>

        <div>
          <h3 class="modal-section-heading">Time Logged</h3>
          <p style="margin: 0 0 1rem; color: var(--ink-soft);">Total: <strong>{formatMinutes(totalMinutes)}</strong></p>
          {timeEntries.length === 0 ? (
            <p class="empty-state">No time logged yet.</p>
          ) : (
            <table class="data-table" style="margin-bottom: 1rem;">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Amount</th>
                  <th>Note</th>
                  <th>Logged By</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {timeEntries.map((entry) => (
                  <tr>
                    <td>{formatDate(entry.entryDate)}</td>
                    <td>{formatMinutes(entry.minutes)}</td>
                    <td>{entry.note ?? "—"}</td>
                    <td>{entry.userName}</td>
                    <td>
                      <form method="post" action="/api/time-entries/delete" onsubmit="return confirm('Delete this time entry?');">
                        <input type="hidden" name="projectId" value={project.id} />
                        <input type="hidden" name="taskId" value={task.id} />
                        <input type="hidden" name="entryId" value={entry.id} />
                        <button class="btn btn-danger" type="submit">Delete</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          <form method="post" action="/api/time-entries/save">
            <input type="hidden" name="projectId" value={project.id} />
            <input type="hidden" name="taskId" value={task.id} />
            <div class="form-grid">
              <div class="field">
                <label>Date</label>
                <input name="date" type="date" required />
              </div>
              <div class="field">
                <label>Amount</label>
                <input name="amount" type="number" step="0.25" min="0" required />
              </div>
              <div class="field">
                <label>Unit</label>
                <select name="unit">
                  <option value="hours">Hours</option>
                  <option value="minutes">Minutes</option>
                </select>
              </div>
              <div class="field full">
                <label>Note</label>
                <input name="note" type="text" />
              </div>
            </div>
            <div class="form-actions">
              <button class="btn btn-primary" type="submit">Log Time</button>
            </div>
          </form>
        </div>
      </template>
    );
  })}
</AdminLayout>

<script>
  import { announce } from "../../../lib/announce";

  document.querySelectorAll<HTMLElement>("[data-note-edit-form]").forEach((form) => {
    const message = form.closest(".thread-message");
    if (!message) return;
    const body = message.querySelector<HTMLElement>("[data-note-body]");
    const actions = message.querySelector<HTMLElement>("[data-note-actions]");
    const editBtn = actions?.querySelector<HTMLElement>("[data-edit-note]");
    const cancelBtn = form.querySelector<HTMLElement>("[data-cancel-edit]");

    editBtn?.addEventListener("click", () => {
      form.hidden = false;
      if (body) body.hidden = true;
      if (actions) actions.hidden = true;
      form.querySelector("textarea")?.focus();
      announce("Editing project note.");
    });

    cancelBtn?.addEventListener("click", () => {
      form.hidden = true;
      if (body) body.hidden = false;
      if (actions) actions.hidden = false;
      editBtn?.focus();
      announce("Project note edit cancelled.");
    });
  });

  const board = document.querySelector<HTMLElement>("[data-kanban]");
  const boardError = document.querySelector<HTMLElement>("[data-board-error]");
  if (board) {
    let draggedEl: HTMLElement | null = null;

    const laneName = (lane: string) =>
      board.querySelector(`[data-lane-select] option[value="${lane}"]`)?.textContent?.trim() ?? lane;

    // Sync everything derived from a card's position: the lane counts, the card's
    // screen-reader lane label, and its lane <select>.
    function syncCard(card: HTMLElement, lane: string) {
      const label = card.querySelector<HTMLElement>("[data-card-lane]");
      if (label) label.textContent = `, in ${laneName(lane)}`;
      const select = card.querySelector("[data-lane-select]") as HTMLSelectElement | null;
      if (select) select.value = lane;
      board!.querySelectorAll<HTMLElement>("[data-lane-dropzone]").forEach((zone) => {
        const count = zone.closest(".kanban-column")?.querySelector<HTMLElement>("[data-lane-count]");
        if (count) count.textContent = String(zone.children.length);
      });
    }

    // The one path for changing a task's lane, whether from a drop or the lane <select>:
    // move the card optimistically, persist, and revert on failure. The result is announced
    // either way (see src/lib/announce.ts).
    async function moveTask(card: HTMLElement, lane: string) {
      const taskId = card.dataset.taskId;
      const originZone = card.parentElement;
      const originLane = originZone?.dataset.laneDropzone;
      const zone = board!.querySelector<HTMLElement>(`[data-lane-dropzone="${lane}"]`);
      if (!taskId || !zone || !originZone || !originLane || originLane === lane) return;

      const title = card.dataset.taskTitle ?? "Task";
      const hadFocus = card.contains(document.activeElement) ? (document.activeElement as HTMLElement) : null;
      if (boardError) boardError.hidden = true;

      zone.appendChild(card);
      syncCard(card, lane);
      // Re-parenting a focused element drops its focus; put it back.
      hadFocus?.focus();

      try {
        const res = await fetch("/api/tasks/update-lane", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ taskId, lane }),
        });
        if (!res.ok) throw new Error(`http_${res.status}`);
        const data = (await res.json()) as { ok?: boolean; error?: string };
        if (!data.ok) throw new Error(data.error ?? "update_failed");
        announce(`Moved “${title}” to ${laneName(lane)}.`);
      } catch {
        originZone.appendChild(card);
        syncCard(card, originLane);
        hadFocus?.focus();
        const message = `Could not move “${title}” to ${laneName(lane)}. It is still in ${laneName(originLane)}. Please try again.`;
        if (boardError) {
          boardError.textContent = message;
          boardError.hidden = false;
        }
        announce(message);
      }
    }

    board.querySelectorAll<HTMLElement>(".kanban-card[draggable]").forEach((card) => {
      card.addEventListener("dragstart", (e) => {
        draggedEl = card;
        card.classList.add("dragging");
        e.dataTransfer?.setData("text/plain", card.dataset.taskId ?? "");
      });
      card.addEventListener("dragend", () => {
        card.classList.remove("dragging");
        draggedEl = null;
      });

      const link = card.querySelector<HTMLElement>(".kanban-card-link");
      link?.addEventListener("click", (e) => {
        // Modifier/middle clicks should still open the real task page in a
        // new tab as normal — only a plain click opens the modal instead.
        if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        openTaskModal("edit", card);
      });

      const select = card.querySelector("[data-lane-select]") as HTMLSelectElement | null;
      select?.addEventListener("change", () => moveTask(card, select.value));
    });

    board.querySelectorAll<HTMLElement>("[data-lane-dropzone]").forEach((zone) => {
      zone.addEventListener("dragover", (e) => {
        e.preventDefault();
        zone.classList.add("drag-over");
      });
      zone.addEventListener("dragleave", () => zone.classList.remove("drag-over"));
      zone.addEventListener("drop", (e) => {
        e.preventDefault();
        zone.classList.remove("drag-over");

        // Capture the dragged element up front: `dragend` fires on the source
        // card right after `drop` and nulls the shared `draggedEl`.
        const el = draggedEl;
        const lane = zone.dataset.laneDropzone;
        if (!el || !lane) return;
        moveTask(el, lane);
      });
    });
  }

  const taskModal = document.querySelector("#task-modal") as HTMLDialogElement | null;
  const taskModalForm = document.querySelector("#task-modal-form") as HTMLFormElement | null;
  const taskModalDeleteForm = document.querySelector("#task-modal-delete-form") as HTMLFormElement | null;
  const taskModalPanels = document.querySelector<HTMLElement>("#task-modal-panels");
  const taskModalHeading = document.querySelector<HTMLElement>("#task-modal-heading");
  const taskModalTaskId = document.querySelector("#task-modal-taskId") as HTMLInputElement | null;
  const taskModalDeleteTaskId = document.querySelector("#task-modal-delete-taskId") as HTMLInputElement | null;
  const taskModalTitle = document.querySelector("#task-modal-title") as HTMLInputElement | null;
  const taskModalDescription = document.querySelector("#task-modal-description") as HTMLTextAreaElement | null;
  const taskModalType = document.querySelector("#task-modal-type") as HTMLSelectElement | null;
  const taskModalPriority = document.querySelector("#task-modal-priority") as HTMLSelectElement | null;
  const taskModalAssignee = document.querySelector("#task-modal-assignee") as HTMLSelectElement | null;

  // Notes/time entries for every task are pre-rendered into inert <template> elements (one per
  // task) rather than fetched — cloning a template's content is how the modal's panels get filled
  // in, with no JSON API involved.
  function renderTaskPanels(taskId: string) {
    if (!taskModalPanels) return;
    taskModalPanels.replaceChildren();
    const template = document.querySelector<HTMLTemplateElement>(`#task-panel-${taskId}`);
    if (template) {
      taskModalPanels.appendChild(template.content.cloneNode(true));
    }
  }

  function openTaskModal(mode: "create" | "edit", card?: HTMLElement) {
    if (
      !taskModal ||
      !taskModalForm ||
      !taskModalDeleteForm ||
      !taskModalHeading ||
      !taskModalTaskId ||
      !taskModalDeleteTaskId ||
      !taskModalTitle ||
      !taskModalDescription ||
      !taskModalType ||
      !taskModalPriority ||
      !taskModalAssignee
    ) {
      return;
    }

    taskModalForm.reset();

    if (mode === "edit" && card) {
      const taskId = card.dataset.taskId ?? "";
      taskModalHeading.textContent = "Edit Task";
      taskModalTaskId.value = taskId;
      taskModalDeleteTaskId.value = taskId;
      taskModalTitle.value = card.dataset.taskTitle ?? "";
      taskModalDescription.value = card.dataset.taskDescription ?? "";
      taskModalType.value = card.dataset.taskType ?? "task";
      taskModalPriority.value = card.dataset.taskPriority ?? "normal";
      taskModalAssignee.value = card.dataset.taskAssignee ?? "";
      taskModalDeleteForm.hidden = false;
      renderTaskPanels(taskId);
    } else {
      taskModalHeading.textContent = "Add Task";
      taskModalTaskId.value = "";
      taskModalDeleteTaskId.value = "";
      taskModalType.value = "task";
      taskModalPriority.value = "normal";
      taskModalDeleteForm.hidden = true;
      taskModalPanels?.replaceChildren();
    }

    taskModal.showModal();
  }

  if (taskModal) {
    document.querySelectorAll<HTMLElement>("[data-open-task-modal]").forEach((trigger) => {
      trigger.addEventListener("click", (e) => {
        if (trigger.dataset.openTaskModal === "edit") return; // handled by the kanban card click listener above
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        openTaskModal("create");
      });
    });

    taskModal.querySelectorAll<HTMLElement>("[data-close-modal]").forEach((btn) => {
      btn.addEventListener("click", () => taskModal.close());
    });

    // Clicking the ::backdrop lands directly on the <dialog> element itself
    // (nothing inside it), so that's how we distinguish an outside click.
    taskModal.addEventListener("click", (e) => {
      if (e.target === taskModal) taskModal.close();
    });

    // The notes/time panels are injected after page load (cloned from a <template>), so the
    // top-of-file per-element note-toggle binding never sees them — use delegation instead.
    taskModalPanels?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const editBtn = target.closest<HTMLElement>("[data-edit-note]");
      const cancelBtn = target.closest<HTMLElement>("[data-cancel-edit]");

      if (editBtn) {
        const message = editBtn.closest(".thread-message");
        const form = message?.querySelector<HTMLElement>("[data-note-edit-form]");
        const body = message?.querySelector<HTMLElement>("[data-note-body]");
        const actions = message?.querySelector<HTMLElement>("[data-note-actions]");
        if (form) form.hidden = false;
        if (body) body.hidden = true;
        if (actions) actions.hidden = true;
        form?.querySelector("textarea")?.focus();
        announce("Editing task note.");
      } else if (cancelBtn) {
        const message = cancelBtn.closest(".thread-message");
        const form = cancelBtn.closest<HTMLElement>("[data-note-edit-form]");
        const body = message?.querySelector<HTMLElement>("[data-note-body]");
        const actions = message?.querySelector<HTMLElement>("[data-note-actions]");
        if (form) form.hidden = true;
        if (body) body.hidden = false;
        if (actions) actions.hidden = false;
        message?.querySelector<HTMLElement>("[data-edit-note]")?.focus();
        announce("Task note edit cancelled.");
      }
    });

    // A task write (save/delete note, log/delete time, save task details) redirects back here
    // with ?openTask=<id> so the modal reopens showing the fresh data instead of leaving the
    // admin back at a closed board after every small change.
    const openTaskId = new URLSearchParams(window.location.search).get("openTask");
    if (openTaskId) {
      const card = board?.querySelector<HTMLElement>(`[data-task-id="${openTaskId}"]`);
      if (card) openTaskModal("edit", card);
      const url = new URL(window.location.href);
      url.searchParams.delete("openTask");
      window.history.replaceState({}, "", url);
    }
  }
</script>
