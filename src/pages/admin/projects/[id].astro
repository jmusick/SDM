---
import { Icon } from "astro-icon/components";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { ensureRole } from "../../../lib/http";
import { getProjectById } from "../../../lib/projects";
import { getClientById } from "../../../lib/clients";
import { listFeaturesByProject, type FeatureStatus } from "../../../lib/features";

export const prerender = false;

const guard = ensureRole(Astro, ["admin"]);
if (guard instanceof Response) return guard;

const { id } = Astro.params;
const project = id ? await getProjectById(Astro.locals, id) : null;
if (!project) {
  return Astro.redirect("/admin/projects");
}

const client = project.clientId ? await getClientById(Astro.locals, project.clientId) : null;
const features = await listFeaturesByProject(Astro.locals, project.id);
const toDateInput = (ms: number | null) => (ms ? new Date(ms).toISOString().slice(0, 10) : "");
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam === "invalid" ? "Project name is required." : null;

const featureStatusBadge: Record<FeatureStatus, string> = {
  backlog: "badge-neutral",
  in_progress: "badge-warning",
  done: "badge-success",
};
---

<AdminLayout title={project.name}>
  {errorMessage && <div class="notice notice-error">{errorMessage}</div>}
  <div class="card" style="max-width: 620px;">
    <p style="margin: 0 0 0.8rem; color: var(--ink-soft);">
      Client: {project.clientId ? <a href={`/admin/clients/${project.clientId}`}>{client?.companyName ?? "Unknown"}</a> : <span class="badge badge-internal">Internal</span>}
    </p>
    <form method="post" action="/api/projects/save">
      <input type="hidden" name="projectId" value={project.id} />
      <div class="form-grid">
        <div class="field full">
          <label for="name">Project Name</label>
          <input id="name" name="name" type="text" required value={project.name} />
        </div>
        <div class="field full">
          <label for="description">Description</label>
          <textarea id="description" name="description">{project.description ?? ""}</textarea>
        </div>
        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="planning" selected={project.status === "planning"}>Planning</option>
            <option value="in_progress" selected={project.status === "in_progress"}>In Progress</option>
            <option value="review" selected={project.status === "review"}>Review</option>
            <option value="on_hold" selected={project.status === "on_hold"}>On Hold</option>
            <option value="completed" selected={project.status === "completed"}>Completed</option>
          </select>
        </div>
        <div class="field">
          <label for="startDate">Start Date</label>
          <input id="startDate" name="startDate" type="date" value={toDateInput(project.startDate)} />
        </div>
        <div class="field">
          <label for="targetDate">Target Date</label>
          <input id="targetDate" name="targetDate" type="date" value={toDateInput(project.targetDate)} />
        </div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save Changes</button>
      </div>
    </form>
  </div>

  <div class="card section-gap" style="max-width: 620px;">
    <div class="header-actions" style="margin-bottom: 1rem; justify-content: space-between;">
      <h2 style="margin: 0; font-family: 'Sora', sans-serif; font-size: 1rem; color: var(--brand-strong);">Features</h2>
      <a class="btn btn-secondary" href={`/admin/projects/${project.id}/features/new`}>
        <Icon class="icon" name="lucide:plus" aria-hidden="true" />
        Add Feature
      </a>
    </div>
    {features.length === 0 ? (
      <p class="empty-state">No features yet.</p>
    ) : (
      <table class="data-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {features.map((feature) => (
            <tr>
              <td><a href={`/admin/projects/${project.id}/features/${feature.id}`}>{feature.title}</a></td>
              <td><span class={`badge ${featureStatusBadge[feature.status]}`}>{feature.status.replace(/_/g, " ")}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

  <div class="card section-gap" style="max-width: 620px;">
    <form method="post" action="/api/projects/delete" onsubmit="return confirm('Delete this project? This cannot be undone.');">
      <input type="hidden" name="projectId" value={project.id} />
      <button class="btn btn-danger" type="submit">
        <Icon class="icon" name="lucide:trash-2" aria-hidden="true" />
        Delete Project
      </button>
    </form>
  </div>
</AdminLayout>
