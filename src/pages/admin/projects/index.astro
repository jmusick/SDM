---
import { Icon } from "astro-icon/components";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { ensureRole } from "../../../lib/http";
import { listAllProjects, type ProjectListItem } from "../../../lib/projects";
import { listClients } from "../../../lib/clients";

export const prerender = false;

const guard = ensureRole(Astro, ["admin"]);
if (guard instanceof Response) return guard;

const statuses = ["planning", "in_progress", "review", "on_hold", "completed"];
const statusBadge: Record<string, string> = {
  planning: "badge-neutral",
  in_progress: "badge-warning",
  review: "badge-warning",
  completed: "badge-success",
  on_hold: "badge-danger",
};

const statusFilter = Astro.url.searchParams.get("status");
const clientFilter = Astro.url.searchParams.get("client");
const sortKey = Astro.url.searchParams.get("sort") ?? "updated";
const sortDir = Astro.url.searchParams.get("dir") === "asc" ? "asc" : "desc";

const clients = await listClients(Astro.locals);
let projects = await listAllProjects(Astro.locals);

if (statusFilter) {
  projects = projects.filter((project) => project.status === statusFilter);
}
if (clientFilter === "internal") {
  projects = projects.filter((project) => !project.clientId);
} else if (clientFilter) {
  projects = projects.filter((project) => project.clientId === clientFilter);
}

const collator = new Intl.Collator("en", { sensitivity: "base" });
const sorters: Record<string, (a: ProjectListItem, b: ProjectListItem) => number> = {
  name: (a, b) => collator.compare(a.name, b.name),
  client: (a, b) => collator.compare(a.companyName ?? "Internal", b.companyName ?? "Internal"),
  status: (a, b) => collator.compare(a.status, b.status),
  updated: (a, b) => a.updatedAt - b.updatedAt,
};
const sorter = sorters[sortKey] ?? sorters.updated;
projects = [...projects].sort((a, b) => (sortDir === "asc" ? sorter(a, b) : -sorter(a, b)));

function buildUrl(overrides: Record<string, string | null>): string {
  const params = new URLSearchParams(Astro.url.searchParams);
  for (const [key, value] of Object.entries(overrides)) {
    if (value === null) params.delete(key);
    else params.set(key, value);
  }
  const qs = params.toString();
  return qs ? `/admin/projects?${qs}` : "/admin/projects";
}

function sortLink(key: string, label: string): { href: string; label: string } {
  const nextDir = sortKey === key && sortDir === "asc" ? "desc" : "asc";
  const arrow = sortKey === key ? (sortDir === "asc" ? " ▲" : " ▼") : "";
  return { href: buildUrl({ sort: key, dir: nextDir }), label: `${label}${arrow}` };
}

const nameSort = sortLink("name", "Project");
const clientSort = sortLink("client", "Client");
const statusSort = sortLink("status", "Status");
---

<AdminLayout title="Projects">
  <div class="header-actions" style="margin-bottom: 1rem; justify-content: space-between; flex-wrap: wrap; gap: 0.6rem;">
    <a class="btn btn-primary" href="/admin/projects/new">
      <Icon class="icon" name="lucide:plus" aria-hidden="true" />
      Add Project
    </a>
    <form method="get" action="/admin/projects" style="display: flex; align-items: center; gap: 0.5rem;">
      {statusFilter && <input type="hidden" name="status" value={statusFilter} />}
      {sortKey !== "updated" && <input type="hidden" name="sort" value={sortKey} />}
      {sortDir !== "desc" && <input type="hidden" name="dir" value={sortDir} />}
      <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: var(--ink-soft);">
        Client
        <select name="client" class="filter-select" style="width: auto;" onchange="this.form.submit()">
          <option value="" selected={!clientFilter}>All Clients</option>
          <option value="internal" selected={clientFilter === "internal"}>Internal</option>
          {clients.map((client) => (
            <option value={client.id} selected={clientFilter === client.id}>{client.companyName}</option>
          ))}
        </select>
      </label>
    </form>
  </div>

  <div class="header-actions" style="margin-bottom: 1rem; gap: 0.4rem;">
    <a class={`btn ${!statusFilter ? "btn-primary" : "btn-secondary"}`} href={buildUrl({ status: null })}>All</a>
    {statuses.map((status) => (
      <a class={`btn ${statusFilter === status ? "btn-primary" : "btn-secondary"}`} href={buildUrl({ status })}>
        {status.replace(/_/g, " ")}
      </a>
    ))}
  </div>

  {projects.length === 0 ? (
    <div class="card empty-state">No projects match these filters.</div>
  ) : (
    <div class="card">
      <table class="data-table">
        <thead>
          <tr>
            <th><a href={nameSort.href}>{nameSort.label}</a></th>
            <th><a href={clientSort.href}>{clientSort.label}</a></th>
            <th><a href={statusSort.href}>{statusSort.label}</a></th>
          </tr>
        </thead>
        <tbody>
          {projects.map((project) => (
            <tr>
              <td><a href={`/admin/projects/${project.id}`}>{project.name}</a></td>
              <td>{project.clientId ? project.companyName : <span class="badge badge-internal">Internal</span>}</td>
              <td><span class={`badge ${statusBadge[project.status]}`}>{project.status.replace(/_/g, " ")}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
