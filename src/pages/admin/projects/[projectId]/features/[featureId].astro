---
import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import { ensureRole } from "../../../../../lib/http";
import { getProjectById } from "../../../../../lib/projects";
import { getFeatureById } from "../../../../../lib/features";

export const prerender = false;

const guard = ensureRole(Astro, ["admin"]);
if (guard instanceof Response) return guard;

const { projectId, featureId } = Astro.params;
const project = projectId ? await getProjectById(Astro.locals, projectId) : null;
const feature = featureId ? await getFeatureById(Astro.locals, featureId) : null;
if (!project || !feature || feature.projectId !== project.id) {
  return Astro.redirect("/admin/projects");
}

const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam === "invalid" ? "A feature title is required." : null;
---

<AdminLayout title={feature.title}>
  {errorMessage && <div class="notice notice-error">{errorMessage}</div>}
  <div class="card" style="max-width: 620px;">
    <form method="post" action="/api/features/save">
      <input type="hidden" name="projectId" value={project.id} />
      <input type="hidden" name="featureId" value={feature.id} />
      <div class="form-grid">
        <div class="field full">
          <label for="title">Title</label>
          <input id="title" name="title" type="text" required value={feature.title} />
        </div>
        <div class="field full">
          <label for="description">Description</label>
          <textarea id="description" name="description">{feature.description ?? ""}</textarea>
        </div>
        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="backlog" selected={feature.status === "backlog"}>Backlog</option>
            <option value="in_progress" selected={feature.status === "in_progress"}>In Progress</option>
            <option value="done" selected={feature.status === "done"}>Done</option>
          </select>
        </div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save Changes</button>
        <a class="btn btn-secondary" href={`/admin/projects/${project.id}`}>Cancel</a>
      </div>
    </form>
  </div>

  <div class="card section-gap" style="max-width: 620px;">
    <form method="post" action="/api/features/delete" onsubmit="return confirm('Delete this feature? This cannot be undone.');">
      <input type="hidden" name="projectId" value={project.id} />
      <input type="hidden" name="featureId" value={feature.id} />
      <button class="btn btn-danger" type="submit">Delete Feature</button>
    </form>
  </div>
</AdminLayout>
