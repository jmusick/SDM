---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { ensureRole } from "../../../lib/http";
import { getInvoiceById } from "../../../lib/invoices";
import { getClientById } from "../../../lib/clients";

export const prerender = false;

const guard = ensureRole(Astro, ["admin"]);
if (guard instanceof Response) return guard;

const { id } = Astro.params;
const invoice = id ? await getInvoiceById(Astro.locals, id) : null;
if (!invoice) {
  return Astro.redirect("/admin/billing");
}

const client = await getClientById(Astro.locals, invoice.clientId);
const toDateInput = (ms: number | null) => (ms ? new Date(ms).toISOString().slice(0, 10) : "");
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam === "invalid" ? "Description and amount are required." : null;
---

<AdminLayout title={invoice.description}>
  {errorMessage && <div class="notice notice-error">{errorMessage}</div>}
  <div class="card" style="max-width: 620px;">
    <p style="margin: 0 0 0.8rem; color: var(--ink-soft);">Client: <a href={`/admin/clients/${invoice.clientId}`}>{client?.companyName ?? "Unknown"}</a></p>
    <form method="post" action="/api/invoices/save">
      <input type="hidden" name="invoiceId" value={invoice.id} />
      <div class="form-grid">
        <div class="field full">
          <label for="description">Description</label>
          <input id="description" name="description" type="text" required value={invoice.description} />
        </div>
        <div class="field">
          <label for="amount">Amount (USD)</label>
          <input id="amount" name="amount" type="number" step="0.01" min="0" required value={(invoice.amountCents / 100).toFixed(2)} />
        </div>
        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="draft" selected={invoice.status === "draft"}>Draft</option>
            <option value="sent" selected={invoice.status === "sent"}>Sent</option>
            <option value="paid" selected={invoice.status === "paid"}>Paid</option>
            <option value="overdue" selected={invoice.status === "overdue"}>Overdue</option>
            <option value="void" selected={invoice.status === "void"}>Void</option>
          </select>
        </div>
        <div class="field">
          <label for="issuedDate">Issued Date</label>
          <input id="issuedDate" name="issuedDate" type="date" value={toDateInput(invoice.issuedDate)} />
        </div>
        <div class="field">
          <label for="dueDate">Due Date</label>
          <input id="dueDate" name="dueDate" type="date" value={toDateInput(invoice.dueDate)} />
        </div>
        <div class="field">
          <label for="paidDate">Paid Date</label>
          <input id="paidDate" name="paidDate" type="date" value={toDateInput(invoice.paidDate)} />
        </div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save Changes</button>
      </div>
    </form>
  </div>

  <div class="card section-gap" style="max-width: 620px;">
    <form method="post" action="/api/invoices/delete" onsubmit="return confirm('Delete this invoice? This cannot be undone.');">
      <input type="hidden" name="invoiceId" value={invoice.id} />
      <button class="btn btn-danger" type="submit">Delete Invoice</button>
    </form>
  </div>
</AdminLayout>
