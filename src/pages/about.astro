---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const currentYear = new Date().getFullYear();
const codingStartYear = 1998;
const yearsExperience = currentYear - codingStartYear;
---

<BaseLayout
  title="About Our Sandusky, OH Web Design Agency | Stone Dragon Media"
  description="Stone Dragon Media is a Sandusky, Ohio web design and digital strategy agency specializing in custom web solutions, application development, and digital marketing."
  canonical="https://stonedragonmedia.com/about/"
  ogUrl="https://stonedragonmedia.com/about/"
  breadcrumb="About"
  ogImage="https://stonedragonmedia.com/about-header.webp"
  ogImageAlt="Desk workspace with design sketches and a laptop"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About Stone Dragon Media",
      "url": "https://stonedragonmedia.com/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Stone Dragon Media",
        "url": "https://stonedragonmedia.com",
        "logo": "https://stonedragonmedia.com/logo.png",
        "telephone": "+1-567-450-0960",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Sandusky",
          "addressRegion": "OH",
          "addressCountry": "US"
        }
      }
    })} />
    <style>
      /* Prose on the left at reading width; the three quick facts stand beside it. */
      .about-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 20rem;
        gap: clamp(2rem, 5vw, 4.5rem);
        align-items: start;
      }

      .prose {
        max-width: 66ch;
      }

      .prose p,
      .prose li {
        color: var(--ink);
      }

      .prose > p:first-child {
        margin-top: 0;
        font-size: 1.15rem;
      }

      .prose ul {
        padding-left: 1.2rem;
      }

      .prose li {
        margin-bottom: 0.6rem;
      }

      .about-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.8rem;
      }

      .facts {
        display: grid;
        gap: 1rem;
      }

      .facts .card h2 {
        font-size: 1.12rem;
      }

      @media (max-width: 920px) {
        .about-layout {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="about" />

  <main id="main-content">
    <PageHero
      image="/about-header.webp"
      alt="Desk workspace with design sketches and a laptop, representing how Stone Dragon Media plans and builds client projects"
      title="A Web Design Agency in Sandusky, Ohio"
      desc="We design websites, build business applications, and help you choose the technology to support your work."
      crumbs={[{ name: "About" }]}
      position="center 70%"
    />

    <div class="page">
      <div class="about-layout">
        <div class="prose">
          <p>
            Stone Dragon Media is a web design and digital strategy agency based in Sandusky, Ohio. We work in person with businesses across Erie County and northern Ohio, from Toledo to Cleveland, and remotely with clients anywhere.
          </p>
          <p>
            With {yearsExperience} years of IT and development experience, we connect design decisions with how your website or application needs to work. Our focus is clear navigation, accessibility, reliable performance, and software you can maintain as your needs change.
          </p>
          <p>
            Our <a href="/services/">services</a> cover:
          </p>
          <ul>
            <li><strong>Custom web design &amp; development</strong> &mdash; <a href="/services/design-development/#custom-web-solutions">Websites and applications</a> built around your goals, from planning to launch.</li>
            <li><strong>Digital strategy &amp; consulting</strong> &mdash; <a href="/services/branding-consulting/#consulting-strategy">Help choosing technology</a>, improving processes, and planning your next project.</li>
            <li><strong>Ongoing support &amp; optimization</strong> &mdash; <a href="/services/hosting-security/#security-maintenance">Maintenance and improvements</a> as your website and business change.</li>
          </ul>
          <p>
            Browse <a href="/work/">our recent work</a> to see what we&rsquo;ve built. If you have a project in mind, tell us what you need and we&rsquo;ll talk through the options.
          </p>
          <div class="about-cta">
            <a class="button button-primary" href="/services/">Explore Our Services</a>
            <a class="button button-secondary" href="/contact/">Start a Project</a>
          </div>
        </div>

        <aside class="facts" aria-label="At a glance">
          <div class="card">
            <Icon class="icon" name="lucide:map-pin" aria-hidden="true" />
            <h2>Based in Sandusky, OH</h2>
            <p>Serving Sandusky, Erie County, and the surrounding area in person, plus remote clients anywhere.</p>
          </div>
          <div class="card">
            <Icon class="icon" name="lucide:history" aria-hidden="true" />
            <h2>{yearsExperience} Years of Experience</h2>
            <p>IT and development experience spanning websites, applications, and infrastructure.</p>
          </div>
          <div class="card">
            <Icon class="icon" name="lucide:target" aria-hidden="true" />
            <h2>Business-First Delivery</h2>
            <p>Design and technology decisions guided by your business goals.</p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
