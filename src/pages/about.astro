---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const currentYear = new Date().getFullYear();
const codingStartYear = 1998;
const yearsExperience = currentYear - codingStartYear;
---

<BaseLayout
  title="About Our Sandusky, OH Web Design Agency | Stone Dragon Media"
  description="Stone Dragon Media is a Sandusky, Ohio web design and digital strategy agency specializing in custom web solutions, application development, and digital marketing."
  canonical="https://stonedragonmedia.com/about/"
  ogUrl="https://stonedragonmedia.com/about/"
  breadcrumb="About"
  ogImage="https://stonedragonmedia.com/about-header.webp"
  ogImageAlt="The Stone Dragon Media teamâ€™s approach to web design and digital strategy"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About Stone Dragon Media",
      "url": "https://stonedragonmedia.com/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Stone Dragon Media",
        "url": "https://stonedragonmedia.com",
        "logo": "https://stonedragonmedia.com/logo.png",
        "telephone": "+1-567-450-0960",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Sandusky",
          "addressRegion": "OH",
          "addressCountry": "US"
        }
      }
    })} />
    <style>
      /* Prose on the left at reading width; the three quick facts stand beside it. */
      .about-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 20rem;
        gap: clamp(2rem, 5vw, 4.5rem);
        align-items: start;
      }

      .prose {
        max-width: 66ch;
      }

      .prose p,
      .prose li {
        color: var(--ink);
      }

      .prose > p:first-child {
        margin-top: 0;
        font-size: 1.15rem;
      }

      .prose ul {
        padding-left: 1.2rem;
      }

      .prose li {
        margin-bottom: 0.6rem;
      }

      .about-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.8rem;
      }

      .facts {
        display: grid;
        gap: 1rem;
      }

      .facts .card h2 {
        font-size: 1.12rem;
      }

      @media (max-width: 920px) {
        .about-layout {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="about" />

  <main id="main-content">
    <PageHero
      image="/about-header.webp"
      alt="Desk workspace with design sketches and a laptop, representing how Stone Dragon Media plans and builds client projects"
      title="About Stone Dragon Media"
      desc="We combine clean design, solid engineering, and practical digital strategy to help organizations launch web solutions and applications that are built to last."
      crumbs={[{ name: "About" }]}
      position="center 70%"
    />

    <div class="page">
      <div class="about-layout">
        <div class="prose">
          <p>
            Founded in Sandusky, Ohio, Stone Dragon Media is dedicated to helping organizations thrive in a digital-first world. We work in person with businesses across Sandusky, Erie County, and northern Ohio, from Toledo in the west to Cleveland in the east, and remotely with clients anywhere. With {yearsExperience} years of IT and development experience, we bring a rare blend of technical depth, creative vision, and business acumen to every project.
          </p>
          <p>
            Our philosophy is simple: build solutions that are clean, robust, and genuinely useful. We believe that great design is more than aesthetics &mdash; it is about clarity, accessibility, and making technology work for people. Our engineering approach is grounded in best practices, modern web stacks, and a relentless focus on reliability and performance.
          </p>
          <p>
            Stone Dragon Media partners with clients of all sizes, from local businesses to national organizations. Our <a href="/services/">services</a> cover:
          </p>
          <ul>
            <li><strong>Custom web design &amp; development</strong> &mdash; From concept to launch, we create <a href="/services/design-development/#custom-web-solutions">sites and applications</a> tailored to your goals.</li>
            <li><strong>Digital strategy &amp; consulting</strong> &mdash; <a href="/services/branding-consulting/#consulting-strategy">Guidance</a> on technology choices, process improvement, and digital transformation.</li>
            <li><strong>Ongoing support &amp; optimization</strong> &mdash; We don&rsquo;t just launch and leave; we help you <a href="/services/hosting-security/#security-maintenance">grow and adapt</a> over time.</li>
          </ul>
          <p>
            Every engagement is driven by measurable outcomes, transparent communication, and a commitment to long-term value. Take a look at <a href="/work/">our recent work</a>, and let&rsquo;s build something remarkable together.
          </p>
          <div class="about-cta">
            <a class="button button-primary" href="/services/">Explore Our Services</a>
            <a class="button button-secondary" href="/contact/">Start a Project</a>
          </div>
        </div>

        <aside class="facts" aria-label="At a glance">
          <div class="card">
            <Icon class="icon" name="lucide:map-pin" aria-hidden="true" />
            <h2>Based in Sandusky, OH</h2>
            <p>Serving Sandusky, Erie County, and the surrounding area in person, plus remote clients anywhere.</p>
          </div>
          <div class="card">
            <Icon class="icon" name="lucide:history" aria-hidden="true" />
            <h2>{yearsExperience} Years of Experience</h2>
            <p>Deep background across infrastructure, industries, and modern web stacks.</p>
          </div>
          <div class="card">
            <Icon class="icon" name="lucide:target" aria-hidden="true" />
            <h2>Business-First Delivery</h2>
            <p>Every engagement is aligned to measurable outcomes, not vanity output.</p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
