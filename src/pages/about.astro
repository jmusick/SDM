---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageBand from "../components/PageBand.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const currentYear = new Date().getFullYear();
const codingStartYear = 1998;
const yearsExperience = currentYear - codingStartYear;
---

<BaseLayout
  title="About Our Sandusky, OH Web Design Agency | Stone Dragon Media"
  description="Stone Dragon Media is a Sandusky, Ohio web design and development studio: custom websites, web applications, hosting, and marketing for businesses in Erie County and beyond."
  canonical="https://stonedragonmedia.com/about/"
  ogUrl="https://stonedragonmedia.com/about/"
  breadcrumb="About"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About Stone Dragon Media",
      "url": "https://stonedragonmedia.com/about/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Stone Dragon Media",
        "url": "https://stonedragonmedia.com",
        "logo": "https://stonedragonmedia.com/logo.png",
        "telephone": "+1-567-450-0960",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Sandusky",
          "addressRegion": "OH",
          "addressCountry": "US"
        }
      }
    })} />
    <style>
      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem clamp(1.1rem, 2.5vw, 2.4rem) 0;
      }

      .footer-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 clamp(1.1rem, 2.5vw, 2.4rem) 4rem;
      }

      p {
        color: var(--ink);
        line-height: 1.6;
      }

      .site-footer {
        margin-top: 2rem;
      }

      .about-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin: 1.4rem 0 1.8rem;
      }

      .about-cta-link {
        display: inline-flex;
        align-items: center;
        padding: 0.65rem 1.1rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-family: "Sora", sans-serif;
        text-decoration: none;
        transition: background-color 160ms ease;
      }

      .about-cta-link:hover {
        background-color: var(--brand-strong);
        color: #edf6ff;
      }

      .about-cta-primary {
        background: var(--brand);
        color: #edf6ff;
      }

      .about-cta-secondary {
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--brand-strong);
      }
    </style>
  </Fragment>

  <SiteHeader active="about" />

  <main class="page" id="main-content">
    <PageBand title="About Stone Dragon Media" description={`A web studio in Sandusky, Ohio, backed by ${yearsExperience} years of IT and development work.`} />
    <p>
      Stone Dragon Media designs and builds websites and web applications from Sandusky, Ohio. We work in person with businesses across Sandusky, Erie County, and northern Ohio, from Toledo in the west to Cleveland in the east, and remotely with clients anywhere. The studio draws on {yearsExperience} years of IT and development experience across infrastructure, industries, and web stacks.
    </p>
    <p>
      We keep the approach plain: pages should load fast, work for everyone, and be easy to change later. Most of what we ship is static pages served from a global CDN, with server code and a database added only where a project needs them. Our own client portal runs on Cloudflare Workers and D1, the same stack we use for client applications.
    </p>
    <p>
      Stone Dragon Media works with clients of all sizes, from local businesses to national organizations. Our <a href="/services/">services</a> cover:
    </p>
    <ul>
      <li><strong>Custom web design &amp; development.</strong> From first sketch to launch, we build <a href="/services/design-development/#custom-web-solutions">sites and applications</a> around what you actually do.</li>
      <li><strong>Digital strategy &amp; consulting.</strong> <a href="/services/branding-consulting/#consulting-strategy">Advice</a> on technology choices, process improvement, and moving manual work onto software.</li>
      <li><strong>Ongoing support &amp; optimization.</strong> We don&rsquo;t launch and disappear. We keep your site <a href="/services/hosting-security/#security-maintenance">patched, monitored, and growing</a> over time.</li>
    </ul>
    <p>
      Take a look at <a href="/work/">our recent work</a>, then tell us what you need.
    </p>
    <div class="about-cta">
      <a class="about-cta-link about-cta-primary" href="/services/">Explore Our Services</a>
      <a class="about-cta-link about-cta-secondary" href="/contact/">Start a Project</a>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
