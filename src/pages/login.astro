---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const { user } = Astro.locals;
if (user) {
  return Astro.redirect(user.role === "admin" ? "/admin" : "/dashboard");
}

const errorParam = Astro.url.searchParams.get("error");
const errorMessage =
  errorParam === "invalid"
    ? "Incorrect email or password."
    : errorParam === "locked"
      ? "Too many failed attempts. Try again in a few minutes."
      : null;
---

<BaseLayout
  title="Client Login | Stone Dragon Media"
  description="Log in to your Stone Dragon Media client dashboard."
  canonical="https://stonedragonmedia.com/login/"
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <style>
      .wrapper {
        max-width: 420px;
        margin: 0 auto;
        padding: 5rem 1.25rem;
      }

      h1 {
        margin: 0 0 0.35rem;
        font-size: 1.7rem;
        color: var(--brand-strong);
        text-align: center;
      }

      .subtitle {
        margin: 0 0 1.3rem;
        color: var(--ink);
        text-align: center;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 0.85rem;
      }

      label {
        font-size: 0.83rem;
        font-weight: 600;
        color: var(--brand-strong);
      }

      input {
        width: 100%;
        border: 1px solid #7d8d9a;
        background: #fff;
        border-radius: 3px;
        padding: 0.7rem 0.8rem;
        font: inherit;
        color: var(--ink);
      }

      .button {
        width: 100%;
        margin-top: 0.3rem;
      }

      .form-status.error {
        margin: 0 0 0.85rem;
        padding: 0.6rem 0.7rem;
        border-radius: 0.62rem;
        font-size: 0.9rem;
        background: rgba(173, 38, 38, 0.12);
        border: 1px solid rgba(173, 38, 38, 0.28);
        color: #7d2121;
      }

      .footer-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 clamp(1.1rem, 2.5vw, 2.4rem) 2rem;
      }

      .site-footer {
        margin-top: 1.6rem;
      }
    </style>
  </Fragment>

  <SiteHeader active="login" />

  <main class="wrapper" id="main-content">
    <h1>Client Login</h1>
    <p class="subtitle">Sign in to view your projects, billing, and support tickets.</p>

    <div class="card form-card">
      {errorMessage && <div class="form-status error" role="alert">{errorMessage}</div>}
      <form method="post" action="/api/auth/login">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" />
        </div>
        <button class="button button-primary" type="submit">
          <Icon class="icon" name="lucide:log-in" aria-hidden="true" />
          Log In
        </button>
      </form>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
