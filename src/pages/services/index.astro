---
import { Icon } from "astro-icon/components";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { serviceCategories } from "../../lib/services";

export const prerender = true;
---

<BaseLayout
  title="Web Design Services in Sandusky, OH | Stone Dragon Media"
  description="Stone Dragon Media offers custom web solutions, application development, SEO, PPC, branding, hosting, and consulting services for businesses of all sizes."
  canonical="https://stonedragonmedia.com/services/"
  ogUrl="https://stonedragonmedia.com/services/"
  breadcrumb="Services"
  ogImage="https://stonedragonmedia.com/services-header.webp"
  ogImageAlt="Stone Dragon Media digital services â€” web design, development, marketing, and consulting"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Services offered by Stone Dragon Media",
      "url": "https://stonedragonmedia.com/services/",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": serviceCategories.map((category, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": category.name,
          "url": `https://stonedragonmedia.com/services/${category.slug}/`
        }))
      }
    })} />
    <style>
      /* The eight services live on four category subpages; this page is the hub that summarises
         each one. Card headings link through, and the list under them names the services inside
         so the hub still says what each category actually covers. */
      .categories {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .categories .card {
        padding: 1.6rem 1.75rem 1.7rem;
      }

      .categories .card h3 {
        font-size: 1.3rem;
      }

      .categories .card ul {
        margin: 0.8rem 0 0;
        padding-left: 1.1rem;
        color: var(--ink-soft);
      }

      .categories .card li {
        margin: 0 0 0.25rem;
      }

      /* Real portfolio screenshots, reused from /work at their native 1180x615. Below the fold —
         keep them lazy with explicit dimensions so LCP and CLS are unaffected. */
      .work-shots {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .proof-more {
        margin: 1.4rem 0 0;
      }

      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .pricing-note {
        max-width: 68ch;
        margin: 1.4rem 0 0;
      }

      @media (max-width: 1100px) {
        .work-shots {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 920px) {
        .categories,
        .pricing-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="services" />

  <main id="main-content">
    <PageHero
      image="/services-header.webp"
      alt="Stone Dragon Media digital services — web design, development, marketing, and consulting"
      title="Web Design & Development Services in Sandusky, Ohio"
      desc="End-to-end digital services including web design, application development, marketing, hosting, branding, and consulting."
      crumbs={[{ name: "Services" }]}
      position="center 70%"
    />

    <div class="page">
      <p class="lead">Stone Dragon Media offers end-to-end digital services from strategy through launch and long-term support, including website solutions built for speed and reliability. Based in Sandusky, Ohio, we work in person across Erie County and northern Ohio, from Toledo in the west to Cleveland in the east, and remotely with clients anywhere.</p>

      <section class="section">
        <h2 class="section-title">What We Do</h2>
        <div class="categories">
          {serviceCategories.map((category) => (
            <article class="card" id={category.slug}>
              <Icon class="icon" name={category.icon} aria-hidden="true" />
              <h3><a href={`/services/${category.slug}/`}>{category.name}</a></h3>
              <p>{category.summary}</p>
              <ul>
                {category.services.map((service) => <li>{service.name}</li>)}
              </ul>
              <a class="card-link" href={`/services/${category.slug}/`}>Explore {category.name}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <h2 class="section-title">Recent Work</h2>
        <div class="work-shots">
          <a class="shot" href="/work/#simon-rook">
            <img src="/work/simonrook.webp" alt="Simon Rook author website" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Simon Rook</span>
          </a>
          <a class="shot" href="/work/#dorian-black">
            <img src="/work/dorianblack.webp" alt="Dorian Black synth-pop artist website" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Dorian Black</span>
          </a>
          <a class="shot" href="/work/#pneumaris">
            <img src="/work/pneumaris.webp" alt="Pneumaris band website" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Pneumaris</span>
          </a>
          <a class="shot" href="/work/#tagstash">
            <img src="/work/tagstash.webp" alt="Tagstash bookmarking tool" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Tagstash</span>
          </a>
        </div>
        <p class="proof-more">See the full breakdown of each build on our <a href="/work/">work page</a>.</p>
      </section>

      <section class="section">
        <h2 class="section-title">How Much Does a Website Cost?</h2>
        <p class="lead">
          Every business is different, so we don&rsquo;t work off a fixed price sheet. We build custom
          pricing and payment arrangements around your budget, timeline, and goals &mdash; not the
          other way around.
        </p>
        <div class="pricing-grid">
          <article class="card">
            <Icon class="icon" name="lucide:badge-dollar-sign" aria-hidden="true" />
            <h3>One-Time Development</h3>
            <p>
              Pay a single project cost, and once it&rsquo;s settled the code is fully yours &mdash; a
              complete license transfer with no ongoing fees, subscriptions, or dependency on us to
              keep running.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:calendar-clock" aria-hidden="true" />
            <h3>Managed, Low Upfront</h3>
            <p>
              Get a professionally built and fully managed site or application with little to no
              money down, with the cost split into affordable monthly or yearly payments instead.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:puzzle" aria-hidden="true" />
            <h3>Custom Arrangements</h3>
            <p>
              Need a mix of both? We&rsquo;ll structure a plan that blends ownership, hosting, and
              ongoing support in whatever combination makes the most sense for your business.
            </p>
          </article>
        </div>
        <p class="pricing-note">
          Not sure which of these fits? Reach out for a free, no-obligation quote and we&rsquo;ll
          walk through the options together.
        </p>
      </section>
    </div>

    <section class="band cta-band">
      <div class="band-inner">
        <h2>Ready to start your next project?</h2>
        <p>Whether you need a new website, a custom application, or a full digital strategy, we are here to help. Let us talk through your goals and build something great together.</p>
        <a class="button button-primary" href="/contact/">
          <Icon class="icon" name="lucide:send" aria-hidden="true" />
          Get in Touch
        </a>
      </div>
    </section>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
