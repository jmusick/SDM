---
import { Icon } from "astro-icon/components";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { serviceCategories } from "../../lib/services";

export const prerender = true;
---

<BaseLayout
  title="Web Design Services in Sandusky, OH | Stone Dragon Media"
  description="Stone Dragon Media offers custom web solutions, application development, SEO, PPC, branding, hosting, and consulting services for businesses of all sizes."
  canonical="https://stonedragonmedia.com/services/"
  ogUrl="https://stonedragonmedia.com/services/"
  breadcrumb="Services"
  ogImage="https://stonedragonmedia.com/services-header.webp"
  ogImageAlt="Stone Dragon Media digital services — web design, development, marketing, and consulting"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Services offered by Stone Dragon Media",
      "url": "https://stonedragonmedia.com/services/",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": serviceCategories.map((category, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": category.name,
          "url": `https://stonedragonmedia.com/services/${category.slug}/`
        }))
      }
    })} />
    <style>
      /* The eight services live on four category subpages; this page is the hub that summarises
         each one. Card headings link through, and the list under them names the services inside
         so the hub still says what each category actually covers. */
      .categories {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .categories .card {
        padding: 1.6rem 1.75rem 1.7rem;
      }

      .categories .card h3 {
        font-size: 1.3rem;
      }

      .categories .card ul {
        margin: 0.8rem 0 0;
        padding-left: 1.1rem;
        color: var(--ink-soft);
      }

      .categories .card li {
        margin: 0 0 0.25rem;
      }

      /* Real portfolio screenshots, reused from /work at their native 1180x615. Below the fold —
         keep them lazy with explicit dimensions so LCP and CLS are unaffected. */
      .work-shots {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .proof-more {
        margin: 1.4rem 0 0;
      }

      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .pricing-note {
        max-width: 68ch;
        margin: 1.4rem 0 0;
      }

      @media (max-width: 1100px) {
        .work-shots {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 920px) {
        .categories,
        .pricing-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="services" />

  <main id="main-content">
    <PageHero
      image="/services-header.webp"
      alt="Stone Dragon Media digital services — web design, development, marketing, and consulting"
      title="Web Design & Development Services in Sandusky, Ohio"
      desc="Website design, custom applications, marketing, hosting, branding, and practical technology advice."
      crumbs={[{ name: "Services" }]}
      position="center 70%"
    />

    <div class="page">
      <p class="lead">Need a new website, help maintaining an existing one, or software for your business? Explore our services below. We work in person across Erie County and northern Ohio, from Toledo to Cleveland, and remotely with clients anywhere.</p>

      <section class="section">
        <h2 class="section-title">What We Do</h2>
        <div class="categories">
          {serviceCategories.map((category) => (
            <article class="card" id={category.slug}>
              <Icon class="icon" name={category.icon} aria-hidden="true" />
              <h3><a href={`/services/${category.slug}/`}>{category.name}</a></h3>
              <p>{category.summary}</p>
              <ul>
                {category.services.map((service) => <li>{service.name}</li>)}
              </ul>
              <a class="card-link" href={`/services/${category.slug}/`}>Explore {category.name}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <h2 class="section-title">Recent Work</h2>
        <div class="work-shots">
          <a class="shot" href="/work/#simon-rook">
            <img src="/work/simonrook.webp" alt="Simon Rook author website" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Simon Rook</span>
            <span class="shot-desc">Author website with book details and purchase links.</span>
          </a>
          <a class="shot" href="/work/#firelands-current">
            <img src="/work/firelands-current.webp" alt="Firelands Current homepage with its teal masthead and local news headlines" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Firelands Current</span>
            <span class="shot-desc">Our local newspaper with events, reader discussions, and newsroom tools.</span>
          </a>
          <a class="shot" href="/work/#pneumaris">
            <img src="/work/pneumaris.webp" alt="Pneumaris band website" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Pneumaris</span>
            <span class="shot-desc">Band website with music players and a contact form.</span>
          </a>
          <a class="shot" href="/work/#tagstash">
            <img src="/work/tagstash.webp" alt="Tagstash bookmarking tool" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Tagstash</span>
            <span class="shot-desc">Our bookmarking application with paid plans and a Firefox extension.</span>
          </a>
        </div>
        <p class="proof-more">See the full breakdown of each build on our <a href="/work/">work page</a>.</p>
      </section>

      <section class="section">
        <h2 class="section-title">How Much Does a Website Cost?</h2>
        <p class="lead">
          Pricing depends on your project&rsquo;s scope, timeline, and support needs. We offer one-time
          development, managed plans, and custom payment arrangements. Tell us your goals and budget,
          and we&rsquo;ll discuss the options.
        </p>
        <div class="pricing-grid">
          <article class="card">
            <Icon class="icon" name="lucide:badge-dollar-sign" aria-hidden="true" />
            <h3>One-Time Development</h3>
            <p>
              Pay a one-time development fee. Once payment is complete, the code and its license
              transfer to you, with no ongoing development subscription or dependency on us.
              We&rsquo;ll discuss hosting and ongoing support separately when planning your project.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:calendar-clock" aria-hidden="true" />
            <h3>Managed Plans with Low Upfront Costs</h3>
            <p>
              A professionally built and managed website or application, with little to no upfront
              payment and costs spread across monthly or yearly payments.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:puzzle" aria-hidden="true" />
            <h3>Custom Arrangements</h3>
            <p>
              Combine development, hosting, and ongoing support in a plan built around your
              business needs.
            </p>
          </article>
        </div>
        <p class="pricing-note">
          Not sure which of these fits? Reach out for a free, no-obligation quote and we&rsquo;ll
          walk through the options together.
        </p>
      </section>
    </div>

    <section class="band cta-band">
      <div class="band-inner">
        <h2>Tell us about your project</h2>
        <p>Share what you need help with, your timeline, and any questions. We&rsquo;ll follow up within one business day. Your consultation is free, with no obligation.</p>
        <a class="button button-primary" href="/contact/">
          <Icon class="icon" name="lucide:send" aria-hidden="true" />
          Discuss Your Project
        </a>
      </div>
    </section>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
