---
import { Icon } from "astro-icon/components";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PageHero from "../../components/PageHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { serviceCategories, type ServiceCategory } from "../../lib/services";

export const prerender = true;

// One template, four prerendered pages — the copy, icons, and JSON-LD all come from
// src/lib/services.ts so the hub and these subpages can't drift apart.
export function getStaticPaths() {
  return serviceCategories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: ServiceCategory;
}

const { category } = Astro.props;
const canonical = `https://stonedragonmedia.com/services/${category.slug}/`;
const siblings = serviceCategories.filter((other) => other.slug !== category.slug);
---

<BaseLayout
  title={`${category.title} | Stone Dragon Media`}
  description={category.description}
  canonical={canonical}
  ogUrl={canonical}
  breadcrumb={category.name}
  breadcrumbParent={{ name: "Services", item: "https://stonedragonmedia.com/services/" }}
  ogImage="https://stonedragonmedia.com/services-header.webp"
  ogImageAlt="Stone Dragon Media digital services — web design, development, marketing, and consulting"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": `${category.name} services from Stone Dragon Media`,
      "itemListElement": category.services.map((service, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "Service",
          "name": service.name,
          "description": service.summary,
          "url": `${canonical}#${service.id}`,
          "serviceType": service.name,
          "provider": {
            "@type": "Organization",
            "name": "Stone Dragon Media",
            "url": "https://stonedragonmedia.com"
          },
          "areaServed": { "@type": "AdministrativeArea", "name": "Erie County, OH" }
        }
      }))
    })} />
    <style>
      /* The two services in this category, given the full width rather than the hub's paired
         cards — this is the page that should actually spell each one out. */
      .services {
        display: grid;
        gap: 1rem;
      }

      .service-card {
        padding: 1.8rem 2rem 2rem;
        scroll-margin-top: 1.5rem;
      }

      .service-card h2 {
        margin-bottom: 0.6rem;
        font-size: clamp(1.35rem, 2vw, 1.7rem);
      }

      .service-card p {
        max-width: 68ch;
      }

      .service-card ul {
        margin: 1rem 0 0 1.1rem;
        padding: 0;
        color: var(--ink-soft);
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.4rem 2rem;
        max-width: 56rem;
      }

      .service-card li {
        margin: 0;
        line-height: 1.5;
      }

      .related-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .related-more {
        max-width: 68ch;
        margin: 1.4rem 0 0;
      }

      @media (max-width: 920px) {
        .related-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .service-card {
          padding: 1.4rem 1.4rem 1.6rem;
        }

        .service-card ul {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="services" />

  <main id="main-content">
    <PageHero
      image="/services-header.webp"
      alt="Stone Dragon Media digital services — web design, development, marketing, and consulting"
      title={category.h1}
      desc={category.heroDesc}
      crumbs={[{ name: "Services", href: "/services/" }, { name: category.name }]}
      position="center 70%"
    />

    <div class="page">
      <p class="lead">{category.intro}</p>

      <div class="services">
        {category.services.map((service) => (
          <article class="card service-card" id={service.id}>
            <Icon class="icon" name={service.icon} aria-hidden="true" />
            <h2>{service.name}</h2>
            <p>{service.summary}</p>
            <ul>
              {service.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <section class="section">
        <h2 class="section-title">Other Services</h2>
        <div class="related-grid">
          {siblings.map((other) => (
            <article class="card">
              <Icon class="icon" name={other.icon} aria-hidden="true" />
              <h3><a href={`/services/${other.slug}/`}>{other.name}</a></h3>
              <p>{other.summary}</p>
              <a class="card-link" href={`/services/${other.slug}/`}>Explore {other.name}</a>
            </article>
          ))}
        </div>
        <p class="related-more">
          See everything we offer on our <a href="/services/">services overview</a>, or browse
          <a href="/work/">recent projects</a> in our portfolio.
        </p>
      </section>
    </div>

    <section class="band cta-band">
      <div class="band-inner">
        <h2>Tell us about your project</h2>
        <p>Share what you need help with, your timeline, and any questions. We&rsquo;ll follow up within one business day. Your consultation is free, with no obligation.</p>
        <a class="button button-primary" href="/contact/">
          <Icon class="icon" name="lucide:send" aria-hidden="true" />
          Discuss Your Project
        </a>
      </div>
    </section>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
