---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="404 | Stone Dragon Media"
  description="The page you requested could not be found."
  canonical="https://stonedragonmedia.com/404"
  ogUrl="https://stonedragonmedia.com/404"
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <style>
      .wrapper {
        max-width: 900px;
        margin: 0 auto;
        padding: 5rem 1.25rem;
        text-align: center;
      }

      h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3rem);
        color: var(--brand-strong);
      }

      p {
        margin: 0.8rem auto 0;
        max-width: 42ch;
        color: var(--ink);
        line-height: 1.6;
      }

      .actions {
        margin-top: 1.3rem;
      }

      .footer-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 clamp(1.1rem, 2.5vw, 2.4rem) 2rem;
      }

      .site-footer {
        margin-top: 1.6rem;
      }
    </style>
  </Fragment>

  <SiteHeader />

  <main class="wrapper" id="main-content">
    <h1>Page Not Found</h1>
    <p>
      We couldn&rsquo;t find that page. Head back to the homepage to explore our services and work.
    </p>
    <div class="actions">
      <a class="button button-primary" href="/">Go to Homepage</a>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
