---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { ensureClientContext } from "../../../lib/http";
import { listTicketsByClient } from "../../../lib/tickets";

export const prerender = false;

const clientResult = await ensureClientContext(Astro);
if (clientResult instanceof Response) return clientResult;
const client = clientResult;
const isImpersonating = Boolean(Astro.locals.impersonatedClient);

const tickets = await listTicketsByClient(Astro.locals, client.id);

const statusBadge: Record<string, string> = {
  open: "badge-warning",
  in_progress: "badge-warning",
  waiting_on_client: "badge-neutral",
  resolved: "badge-success",
  closed: "badge-neutral",
};
---

<DashboardLayout title="Tickets">
  {!isImpersonating && (
    <div class="header-actions" style="margin-bottom: 1rem;">
      <a class="btn btn-primary" href="/dashboard/tickets/new">Open New Ticket</a>
    </div>
  )}

  {tickets.length === 0 ? (
    <div class="card empty-state">No tickets yet.</div>
  ) : (
    <div class="card">
      <table class="data-table">
        <thead>
          <tr>
            <th>Subject</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {tickets.map((ticket) => (
            <tr>
              <td><a href={`/dashboard/tickets/${ticket.id}`}>{ticket.subject}</a></td>
              <td><span class={`badge ${statusBadge[ticket.status]}`}>{ticket.status.replace(/_/g, " ")}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</DashboardLayout>
