---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import SettingsForm from "../../components/SettingsForm.astro";
import { requireUser } from "../../lib/http";
import { getUserById } from "../../lib/users";

export const prerender = false;

const guard = requireUser(Astro);
if (guard instanceof Response) return guard;

// This page manages the logged-in user's own settings, not an impersonated
// client's — if an admin is impersonating, their own settings live at
// /admin/settings instead, so send them there rather than editing the
// client's account on their behalf.
if (guard.role !== "client") {
  return Astro.redirect("/admin/settings");
}

const user = await getUserById(Astro.locals, guard.id);
if (!user) {
  return Astro.redirect("/login");
}

const errorParam = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  invalid_email: "Enter a valid email address.",
  email_taken: "That email is already in use by another account.",
  password_too_short: "New password must be at least 10 characters.",
  password_mismatch: "New password and confirmation don't match.",
  wrong_password: "Current password is incorrect.",
};
const errorMessage = errorParam ? errorMessages[errorParam] ?? "Something went wrong." : null;

const savedParam = Astro.url.searchParams.get("saved");
const successMessage = savedParam === "password" ? "Password updated." : savedParam === "1" ? "Profile saved." : null;
---

<DashboardLayout title="Settings">
  <SettingsForm user={user} backTo="/dashboard/settings" errorMessage={errorMessage} successMessage={successMessage} />
</DashboardLayout>
