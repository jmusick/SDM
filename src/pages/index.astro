---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialProfileUrls } from "../lib/social";

export const prerender = true;

const currentYear = new Date().getFullYear();
const codingStartYear = 1998;
const yearsExperience = currentYear - codingStartYear;
---

<BaseLayout
  title="Web Design in Sandusky, Ohio | Stone Dragon Media"
  description="Stone Dragon Media is a Sandusky, Ohio web design studio serving Erie County and the surrounding area, and remote clients anywhere. Custom websites, web applications, hosting, and marketing."
  canonical="https://stonedragonmedia.com/"
  ogUrl="https://stonedragonmedia.com/"
  ogImage="https://stonedragonmedia.com/header-bg.webp"
  ogImageAlt="Stone Dragon Media: custom web design in Sandusky, Ohio"
  includeGenerator={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness"],
      "name": "Stone Dragon Media",
      "url": "https://stonedragonmedia.com",
      "logo": "https://stonedragonmedia.com/logo.png",
      "image": "https://stonedragonmedia.com/logo.png",
      "description": "Stone Dragon Media builds custom websites and web applications, and provides hosting, digital marketing, and consulting for businesses in Sandusky, Ohio and beyond.",
      "telephone": "+1-567-450-0960",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sandusky",
        "addressRegion": "OH",
        "addressCountry": "US"
      },
      "areaServed": [
        "Sandusky, OH",
        "Erie County, OH",
        "Huron, OH",
        "Castalia, OH",
        "Milan, OH",
        "Berlin Heights, OH",
        "Vermilion, OH",
        "Wakeman, OH",
        "Norwalk, OH",
        "Monroeville, OH",
        "Bellevue, OH",
        "Clyde, OH",
        "Willard, OH",
        "New London, OH",
        "Fremont, OH",
        "Tiffin, OH",
        "Port Clinton, OH",
        "Marblehead, OH",
        "Catawba Island, OH",
        "Oak Harbor, OH",
        "Kelleys Island, OH",
        "Put-in-Bay, OH",
        "Amherst, OH",
        "Oberlin, OH",
        "Toledo, OH",
        "Cleveland, OH",
        "Lorain, OH",
        "Elyria, OH",
        "US"
      ],
      "sameAs": socialProfileUrls
    })} />
    <style>
      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem clamp(1.1rem, 2.5vw, 2.4rem) 0;
      }

      .footer-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 clamp(1.1rem, 2.5vw, 2.4rem) 4.5rem;
      }

      .site-nav {
        margin-right: 0.45rem;
      }

      .brand-logo {
        width: min(100%, 380px);
        height: auto;
        display: block;
        filter: contrast(1.15) brightness(1.07);
      }

      .header-hero {
        position: relative;
        width: 100vw;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        height: 520px;
        max-width: 100vw;
        border-radius: 0;
        overflow: hidden;
        box-shadow: none;
        margin-bottom: 1rem;
        background: #122238;
      }

      .header-hero img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        object-position: center 35%;
      }

      .header-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 3.5rem 3.5rem 3.5rem max(8vw, calc((100vw - 1280px) / 2 + clamp(1.1rem, 2.5vw, 2.4rem)));
        color: #fff;
        background: linear-gradient(90deg, rgba(18, 34, 56, 0.82) 0%, rgba(18, 34, 56, 0.32) 60%, rgba(18, 34, 56, 0) 100%);
        font-family: "Sora", sans-serif;
        pointer-events: none;
        box-sizing: border-box;
      }

      .header-overlay .hero-title {
        font-size: 2.8rem;
        font-weight: 800;
        margin: 0 0 1.2rem;
        line-height: 1.1;
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
      }

      .header-overlay .hero-desc {
        font-size: 1.25rem;
        font-weight: 400;
        max-width: 32rem;
        line-height: 1.5;
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
      }

      .cta {
        margin-top: 2.2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        pointer-events: all;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.72rem 1.12rem;
        border-radius: 0.82rem;
        border: 1px solid transparent;
        font-weight: 600;
        text-decoration: none;
        font-family: "Sora", sans-serif;
        transition: background-color 160ms ease, border-color 160ms ease;
      }

      .button-primary {
        background: var(--brand);
        color: #edf6ff;
      }

      .button-secondary {
        border-color: rgba(191, 224, 248, 0.45);
        color: #e6f2ff;
        background: rgba(17, 44, 68, 0.45);
      }

      .panel {
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.2rem;
        background: rgba(233, 241, 248, 0.9);
      }

      .panel p {
        color: var(--ink-soft);
      }

      .areas-list {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.4rem 1rem;
        margin: 0.9rem 0;
        padding: 0;
        list-style: none;
      }

      .areas-list li {
        color: var(--ink-soft);
        font-weight: 600;
      }

      @media (max-width: 640px) {
        .areas-list {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      section {
        margin-top: 1.1rem;
      }

      section:first-child {
        margin-top: 0;
      }

      .site-footer {
        margin-top: 2.2rem;
        padding-top: 1.25rem;
      }

      .services {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.3rem 2.4rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .services li {
        padding-top: 0.9rem;
        border-top: 2px solid var(--brand);
      }

      h2 {
        margin: 0 0 1rem;
        font-size: clamp(1.4rem, 2vw, 1.8rem);
        font-family: "Sora", sans-serif;
        color: var(--brand-strong);
      }

      h3 {
        margin: 0 0 0.45rem;
        font-size: 1.04rem;
        color: var(--brand-strong);
      }

      .services p {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.96rem;
      }

      .services h3 a {
        color: inherit;
        text-decoration: none;
      }

      .services h3 a:hover {
        text-decoration: underline;
        text-underline-offset: 0.15em;
      }

      .services-more {
        margin: 1rem 0 0;
        color: var(--ink);
      }

      @media (max-width: 920px) {
        .site-nav {
          margin-right: 0;
        }

        .services {
          grid-template-columns: 1fr;
        }

        .header-hero {
          height: clamp(470px, 86vw, 640px);
        }

        .header-overlay {
          padding: 2rem 1.2rem;
          align-items: flex-start;
        }

        .header-overlay .hero-title {
          font-size: 2rem;
        }

        .header-overlay .hero-desc {
          font-size: 1rem;
        }

        .site-footer {
          padding-top: 1.2rem;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="home" showCta={true} />

  <div class="header-hero">
    <img src="/header-bg.webp" alt="Low-poly dragon over a mountain landscape, the Stone Dragon Media mark" />
    <div class="header-overlay">
      <h1 class="hero-title">Websites and web apps, built in Sandusky, Ohio</h1>
      <span class="hero-desc">
        Stone Dragon Media designs, builds, and hosts websites and web applications from
        Sandusky, Ohio, with {yearsExperience} years of IT and development experience behind it.
      </span>
      <div class="cta">
        <a class="button button-primary" href="/contact/">
          Book Discovery Call
        </a>
        <a class="button button-secondary" href="/services/">
          View Services
        </a>
      </div>
    </div>
  </div>

  <main class="page" id="main-content">
    <section id="services">
      <h2>What We Do</h2>
      <ul class="services">
        <li>
          <h3><a href="/services/design-development/#custom-web-solutions">Custom Websites</a></h3>
          <p>eCommerce sites, informational websites, and landing pages, built as fast static pages wherever the project allows.</p>
        </li>
        <li>
          <h3><a href="/services/design-development/#application-development">Custom Application Development</a></h3>
          <p>Internal tools, customer portals, workflow automation, and API integrations, like the client portal we built for ourselves.</p>
        </li>
        <li>
          <h3><a href="/services/marketing-analytics/#marketing">Marketing</a></h3>
          <p>SEO, PPC, social media, email, and content that bring in the right visitors.</p>
        </li>
        <li>
          <h3><a href="/services/marketing-analytics/#analytics-reporting">Analytics &amp; Reporting</a></h3>
          <p>GA4 setup, conversion tracking, custom dashboards, and performance audits.</p>
        </li>
        <li>
          <h3><a href="/services/hosting-security/#hosting-infrastructure">Hosting &amp; Infrastructure</a></h3>
          <p>Domains, cloud and VPS setup, SSL, performance tuning, and backup planning.</p>
        </li>
        <li>
          <h3><a href="/services/hosting-security/#security-maintenance">Security &amp; Maintenance</a></h3>
          <p>Security hardening, updates, uptime monitoring, and vulnerability assessments.</p>
        </li>
        <li>
          <h3><a href="/services/branding-consulting/#branding-design">Branding &amp; Design</a></h3>
          <p>Logos, brand style guides, color and typography systems, and print and digital assets.</p>
        </li>
        <li>
          <h3><a href="/services/branding-consulting/#consulting-strategy">Consulting &amp; Strategy</a></h3>
          <p>Technology selection, data migration, and project roadmaps.</p>
        </li>
      </ul>
      <p class="services-more">
        See the full breakdown on our <a href="/services/">services page</a>, browse
        <a href="/work/">recent projects</a> in our portfolio, or read more
        <a href="/about/">about Stone Dragon Media</a> and the
        <a href="/products/">products we build</a>.
      </p>
    </section>

    <section id="areas-served">
      <h2>Areas We Serve</h2>
      <div class="panel">
        <p>
          Stone Dragon Media is based in Sandusky, Ohio. We work on site with businesses across
          Sandusky, Erie County, and the surrounding communities:
        </p>
        <ul class="areas-list">
          <li>Sandusky</li>
          <li>Huron</li>
          <li>Castalia</li>
          <li>Milan</li>
          <li>Berlin Heights</li>
          <li>Vermilion</li>
          <li>Wakeman</li>
          <li>Norwalk</li>
          <li>Monroeville</li>
          <li>Bellevue</li>
          <li>Clyde</li>
          <li>Willard</li>
          <li>New London</li>
          <li>Fremont</li>
          <li>Tiffin</li>
          <li>Port Clinton</li>
          <li>Marblehead</li>
          <li>Catawba Island</li>
          <li>Oak Harbor</li>
          <li>Kelleys Island</li>
          <li>Put-in-Bay</li>
          <li>Amherst</li>
          <li>Oberlin</li>
        </ul>
        <p>
          We also meet clients in person within about an hour&rsquo;s drive: Toledo to the
          west, Cleveland to the east, and the Lorain and Elyria corridor in between. Farther out,
          including Columbus, Akron, Canton, and Lima, we work remotely, as we do with clients
          anywhere in the US.
        </p>
      </div>
    </section>

  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
