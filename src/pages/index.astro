---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialProfileUrls } from "../lib/social";

export const prerender = true;

const currentYear = new Date().getFullYear();
const codingStartYear = 1998;
const yearsExperience = currentYear - codingStartYear;
---

<BaseLayout
  title="Web Design in Sandusky, Ohio | Stone Dragon Media"
  description="Stone Dragon Media is a Sandusky, Ohio web design agency serving Erie County and the surrounding area — and remote clients anywhere. Custom web solutions, development, and digital marketing."
  canonical="https://stonedragonmedia.com/"
  ogUrl="https://stonedragonmedia.com/"
  ogImage="https://stonedragonmedia.com/header-bg.webp"
  ogImageAlt="Stone Dragon Media — custom web design and digital strategy in Sandusky, Ohio"
  includeGenerator={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness"],
      "name": "Stone Dragon Media",
      "url": "https://stonedragonmedia.com",
      "logo": "https://stonedragonmedia.com/logo.png",
      "image": "https://stonedragonmedia.com/logo.png",
      "description": "Stone Dragon Media builds custom web solutions, application development, digital marketing, and consulting services for growing businesses.",
      "telephone": "+1-567-450-0960",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sandusky",
        "addressRegion": "OH",
        "addressCountry": "US"
      },
      "areaServed": [
        "Sandusky, OH",
        "Erie County, OH",
        "Huron, OH",
        "Castalia, OH",
        "Milan, OH",
        "Berlin Heights, OH",
        "Vermilion, OH",
        "Wakeman, OH",
        "Norwalk, OH",
        "Monroeville, OH",
        "Bellevue, OH",
        "Clyde, OH",
        "Willard, OH",
        "New London, OH",
        "Fremont, OH",
        "Tiffin, OH",
        "Port Clinton, OH",
        "Marblehead, OH",
        "Catawba Island, OH",
        "Oak Harbor, OH",
        "Kelleys Island, OH",
        "Put-in-Bay, OH",
        "Amherst, OH",
        "Oberlin, OH",
        "Toledo, OH",
        "Cleveland, OH",
        "Lorain, OH",
        "Elyria, OH",
        "US"
      ],
      "sameAs": socialProfileUrls
    })} />
    <style>
      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem clamp(1.1rem, 2.5vw, 2.4rem) 0;
      }

      .footer-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 clamp(1.1rem, 2.5vw, 2.4rem) 4.5rem;
      }

      .site-nav {
        margin-right: 0.45rem;
      }

      .brand-logo {
        width: min(100%, 380px);
        height: auto;
        display: block;
        filter: contrast(1.15) brightness(1.07);
      }

      .header-hero {
        position: relative;
        width: 100vw;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        height: 520px;
        max-width: 100vw;
        border-radius: 0;
        overflow: hidden;
        box-shadow: none;
        margin-bottom: 1rem;
        background: #122238;
      }

      .header-hero img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        object-position: center 35%;
      }

      .header-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 3.5rem 3.5rem 3.5rem max(8vw, calc((100vw - 1280px) / 2 + clamp(1.1rem, 2.5vw, 2.4rem)));
        color: #fff;
        background: linear-gradient(90deg, rgba(18, 34, 56, 0.82) 0%, rgba(18, 34, 56, 0.32) 60%, rgba(18, 34, 56, 0) 100%);
        font-family: "Sora", sans-serif;
        pointer-events: none;
        box-sizing: border-box;
      }

      .header-overlay .about-label {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.13em;
        margin-bottom: 0.7rem;
        opacity: 0.92;
        border-bottom: 3px solid #7fa6d9;
        display: inline-block;
        padding-bottom: 0.2rem;
        text-transform: uppercase;
      }

      .header-overlay .hero-title {
        font-size: 2.8rem;
        font-weight: 800;
        margin: 0 0 1.2rem;
        line-height: 1.1;
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
      }

      .header-overlay .hero-desc {
        font-size: 1.25rem;
        font-weight: 400;
        max-width: 32rem;
        line-height: 1.5;
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
      }

      .cta {
        margin-top: 2.2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        pointer-events: all;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.72rem 1.12rem;
        border-radius: 0.82rem;
        border: 1px solid transparent;
        font-weight: 600;
        text-decoration: none;
        font-family: "Sora", sans-serif;
        transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
      }

      .button .icon {
        width: 1rem;
        height: 1rem;
        margin-right: 0.45rem;
        flex-shrink: 0;
      }

      .button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(14, 46, 73, 0.2);
      }

      .button-primary {
        background: linear-gradient(125deg, #1f5a89, #2f709f);
        color: #edf6ff;
      }

      .button-secondary {
        border-color: rgba(191, 224, 248, 0.45);
        color: #e6f2ff;
        background: rgba(17, 44, 68, 0.45);
      }

      .panel,
      .services article,
      .metric {
        border: 1px solid var(--line);
        background: var(--surface);
        box-shadow: 0 16px 30px rgba(18, 45, 69, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.5);
      }

      .panel {
        border-radius: 1rem;
        padding: 1.2rem;
        background: rgba(233, 241, 248, 0.9);
      }

      .panel p {
        color: var(--ink-soft);
      }

      .areas-list {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.4rem 1rem;
        margin: 0.9rem 0;
        padding: 0;
        list-style: none;
      }

      .areas-list li {
        color: var(--ink-soft);
        font-weight: 600;
      }

      @media (max-width: 640px) {
        .areas-list {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .metric {
        border-radius: 0.8rem;
        padding: 0.95rem;
      }

      .metric .icon {
        width: 1rem;
        height: 1rem;
        color: var(--brand);
        margin-bottom: 0.35rem;
      }

      .metric strong {
        display: block;
        font-size: 1.2rem;
        color: var(--brand-strong);
      }

      .metric span {
        font-size: 0.93rem;
        color: var(--ink-soft);
      }

      section {
        margin-top: 1.1rem;
      }

      section:first-child {
        margin-top: 0;
      }

      .site-footer {
        margin-top: 2.2rem;
        padding-top: 1.25rem;
      }

      .services {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .services article {
        padding: 1rem;
        border-radius: 0.9rem;
      }

      .service-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* Matches the watermark treatment on /services — see that page for the opacity rationale.
         The icon is absolutely positioned so it leaves the .service-title flex row entirely. */
      .services article {
        position: relative;
        overflow: hidden;
      }

      .service-title .icon {
        position: absolute;
        right: -0.5rem;
        bottom: -0.6rem;
        font-size: 9rem;
        height: 82%;
        width: auto;
        aspect-ratio: 1 / 1;
        margin: 0;
        color: var(--brand-strong);
        opacity: 0.05;
        z-index: 0;
        pointer-events: none;
      }

      .service-title,
      .services p {
        position: relative;
        z-index: 1;
      }

      h2 {
        margin: 0 0 1rem;
        font-size: clamp(1.4rem, 2vw, 1.8rem);
        font-family: "Sora", sans-serif;
        color: var(--brand-strong);
      }

      h3 {
        margin: 0 0 0.45rem;
        font-size: 1.04rem;
        color: var(--brand-strong);
      }

      .services p {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.96rem;
      }

      .services h3 a {
        color: inherit;
        text-decoration: none;
      }

      .services h3 a:hover {
        text-decoration: underline;
        text-underline-offset: 0.15em;
      }

      .services-more {
        margin: 1rem 0 0;
        color: var(--ink);
      }

      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(14px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 920px) {
        .site-nav {
          margin-right: 0;
        }

        .services {
          grid-template-columns: 1fr;
        }

        .header-hero {
          height: clamp(470px, 86vw, 640px);
        }

        .header-overlay {
          padding: 2rem 1.2rem;
          align-items: flex-start;
        }

        .header-overlay .hero-title {
          font-size: 2rem;
        }

        .header-overlay .hero-desc {
          font-size: 1rem;
        }

        .site-footer {
          padding-top: 1.2rem;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="home" showCta={true} />

  <div class="header-hero">
    <img src="/header-bg.webp" alt="Stone Dragon Media — custom web design and digital strategy agency based in Sandusky, Ohio" />
    <div class="header-overlay">
      <span class="about-label">SANDUSKY, OHIO WEB DESIGN &amp; DIGITAL STRATEGY</span>
      <h1 class="hero-title">Sandusky, Ohio web design for growing brands</h1>
      <span class="hero-desc">
        Custom web solutions, application development, hosting, and consulting to help businesses
        scale online. Based in Sandusky, Ohio, with {yearsExperience} years of IT and development experience.
      </span>
      <div class="cta">
        <a class="button button-primary" href="/contact/">
          <Icon class="icon" name="lucide:calendar-check-2" aria-hidden="true" />
          Book Discovery Call
        </a>
        <a class="button button-secondary" href="/services/">
          <Icon class="icon" name="lucide:sparkles" aria-hidden="true" />
          View Services
        </a>
      </div>
    </div>
  </div>

  <main class="page" id="main-content">
    <section id="services">
      <h2>Our Web Design &amp; Digital Services</h2>
      <div class="services">
        <article>
          <div class="service-title">
            <Icon class="icon" name="lucide:layout-template" aria-hidden="true" />
            <h3><a href="/services/design-development/#custom-web-solutions">Custom Web Solutions</a></h3>
          </div>
          <p>
            eCommerce sites, informational websites, landing pages, and custom business solutions built fast and built to last.
          </p>
        </article>
        <article>
          <div class="service-title">
            <Icon class="icon" name="lucide:cpu" aria-hidden="true" />
            <h3><a href="/services/design-development/#application-development">Custom Application Development</a></h3>
          </div>
          <p>
            Internal tools, customer portals, workflow automation, and API integrations tailored to your operations.
          </p>
        </article>
        <article>
          <div class="service-title">
            <Icon class="icon" name="lucide:megaphone" aria-hidden="true" />
            <h3><a href="/services/marketing-analytics/#marketing">Marketing</a></h3>
          </div>
          <p>
            SEO, PPC, social media, email, and content strategies that drive qualified traffic and measurable growth.
          </p>
        </article>
        <article>
          <div class="service-title">
            <Icon class="icon" name="lucide:bar-chart-2" aria-hidden="true" />
            <h3><a href="/services/marketing-analytics/#analytics-reporting">Analytics &amp; Reporting</a></h3>
          </div>
          <p>
            GA4 setup, conversion tracking, custom dashboards, and performance audits to turn data into decisions.
          </p>
        </article>
        <article>
          <div class="service-title">
            <Icon class="icon" name="lucide:server" aria-hidden="true" />
            <h3><a href="/services/hosting-security/#hosting-infrastructure">Hosting &amp; Infrastructure</a></h3>
          </div>
          <p>
            Domain management, cloud and VPS server setup, SSL, performance optimization, and backup planning.
          </p>
        </article>
        <article>
          <div class="service-title">
            <Icon class="icon" name="lucide:shield" aria-hidden="true" />
            <h3><a href="/services/hosting-security/#security-maintenance">Security &amp; Maintenance</a></h3>
          </div>
          <p>
            Ongoing site care including security hardening, updates, uptime monitoring, and vulnerability assessments.
          </p>
        </article>
        <article>
          <div class="service-title">
            <Icon class="icon" name="lucide:palette" aria-hidden="true" />
            <h3><a href="/services/branding-consulting/#branding-design">Branding &amp; Design</a></h3>
          </div>
          <p>
            Logo design, brand style guides, color and typography systems, and print and digital asset creation.
          </p>
        </article>
        <article>
          <div class="service-title">
            <Icon class="icon" name="lucide:compass" aria-hidden="true" />
            <h3><a href="/services/branding-consulting/#consulting-strategy">Consulting &amp; Strategy</a></h3>
          </div>
          <p>
            Technology selection, digital transformation planning, data migration, and project roadmapping.
          </p>
        </article>
      </div>
      <p class="services-more">
        See the full breakdown on our <a href="/services/">services page</a>, browse
        <a href="/work/">recent projects</a> in our portfolio, or read more
        <a href="/about/">about Stone Dragon Media</a> and the
        <a href="/products/">products we build</a>.
      </p>
    </section>

    <section id="areas-served">
      <h2>Areas We Serve</h2>
      <div class="panel">
        <p>
          Stone Dragon Media is based in Sandusky, Ohio. We work on site with businesses across
          Sandusky, Erie County, and the surrounding communities:
        </p>
        <ul class="areas-list">
          <li>Sandusky</li>
          <li>Huron</li>
          <li>Castalia</li>
          <li>Milan</li>
          <li>Berlin Heights</li>
          <li>Vermilion</li>
          <li>Wakeman</li>
          <li>Norwalk</li>
          <li>Monroeville</li>
          <li>Bellevue</li>
          <li>Clyde</li>
          <li>Willard</li>
          <li>New London</li>
          <li>Fremont</li>
          <li>Tiffin</li>
          <li>Port Clinton</li>
          <li>Marblehead</li>
          <li>Catawba Island</li>
          <li>Oak Harbor</li>
          <li>Kelleys Island</li>
          <li>Put-in-Bay</li>
          <li>Amherst</li>
          <li>Oberlin</li>
        </ul>
        <p>
          We also meet clients in person within about an hour&rsquo;s drive &mdash; Toledo to the
          west, Cleveland to the east, and the Lorain and Elyria corridor in between. Farther out,
          including Columbus, Akron, Canton, and Lima, we work remotely, as we do with clients
          anywhere in the US.
        </p>
      </div>
    </section>

  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
