---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialProfileUrls } from "../lib/social";

export const prerender = true;

---

<BaseLayout
  title="Web Design in Sandusky, Ohio | Stone Dragon Media"
  description="Custom web design, business applications, and digital strategy in Sandusky, Ohio. Serving local businesses and remote clients across the US."
  canonical="https://stonedragonmedia.com/"
  ogUrl="https://stonedragonmedia.com/"
  ogImage="https://stonedragonmedia.com/header-bg.webp"
  ogImageAlt="Stone Dragon Media — custom web design and digital strategy in Sandusky, Ohio"
  includeGenerator={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness"],
      "name": "Stone Dragon Media",
      "url": "https://stonedragonmedia.com",
      "logo": "https://stonedragonmedia.com/logo.png",
      "image": "https://stonedragonmedia.com/logo.png",
      "description": "Stone Dragon Media provides custom web design, business applications, digital marketing, and consulting in Sandusky, Ohio, and for remote clients.",
      "telephone": "+1-567-450-0960",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sandusky",
        "addressRegion": "OH",
        "addressCountry": "US"
      },
      "areaServed": [
        "Sandusky, OH",
        "Erie County, OH",
        "Huron, OH",
        "Castalia, OH",
        "Milan, OH",
        "Berlin Heights, OH",
        "Vermilion, OH",
        "Wakeman, OH",
        "Norwalk, OH",
        "Monroeville, OH",
        "Bellevue, OH",
        "Clyde, OH",
        "Willard, OH",
        "New London, OH",
        "Fremont, OH",
        "Tiffin, OH",
        "Port Clinton, OH",
        "Marblehead, OH",
        "Catawba Island, OH",
        "Oak Harbor, OH",
        "Kelleys Island, OH",
        "Put-in-Bay, OH",
        "Amherst, OH",
        "Oberlin, OH",
        "Toledo, OH",
        "Cleveland, OH",
        "Lorain, OH",
        "Elyria, OH",
        "US"
      ],
      "sameAs": socialProfileUrls
    })} />
    <style>
      /* 4 x 2 on wide screens, so all eight services read as one block. */
      .services {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
      }

      .services .card {
        min-height: 12.5rem;
      }

      .services .card p {
        font-size: 0.97rem;
      }

      .services-more {
        max-width: 68ch;
        margin: 1.4rem 0 0;
      }

      .work-shots {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .hero-note {
        flex-basis: 100%;
        margin: 0.5rem 0 0;
        font-size: 0.95rem;
        color: #dfe7ed;
      }

      .hero-note span {
        display: block;
        max-width: 34rem;
      }

      .areas-list {
        columns: 5 11rem;
        column-gap: 2rem;
        margin: 1.6rem 0 1.8rem;
        padding: 1.4rem 0;
        list-style: none;
        border-top: 1px solid rgba(169, 193, 212, 0.25);
        border-bottom: 1px solid rgba(169, 193, 212, 0.25);
      }

      .areas-list li {
        padding: 0.2rem 0;
        font-weight: 600;
        color: #fff;
        break-inside: avoid;
      }

      @media (max-width: 1100px) {
        .services,
        .work-shots {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 640px) {
        .services {
          grid-template-columns: 1fr;
        }

        .services .card {
          min-height: 0;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="home" showCta={true} />

  <main id="main-content">
    <PageHero
      tall
      image="/header-bg.webp"
      alt="Stone Dragon Media — custom web design and digital strategy agency based in Sandusky, Ohio"
      title="Sandusky, Ohio web design for your business"
      desc="Make it easy for customers to understand what you offer and get in touch. We build custom websites and business applications, with ongoing support after launch."
      position="center 35%"
    >
      <a class="button button-primary" href="/contact/">
        <Icon class="icon" name="lucide:send" aria-hidden="true" />
        Discuss Your Project
      </a>
      <a class="button button-secondary" href="/services/">View Services</a>
      <p class="hero-note">
        <span>IT and development experience since 1998.</span>
        <span>Free consultations. We reply within one business day.</span>
      </p>
    </PageHero>

    <div class="page">
      <section class="section" id="services">
        <h2 class="section-title">Our Web Design &amp; Digital Services</h2>
        <div class="services">
          <article class="card">
            <Icon class="icon" name="lucide:layout-template" aria-hidden="true" />
            <h3><a href="/services/design-development/#custom-web-solutions">Custom Web Solutions</a></h3>
            <p>
              Custom websites, online stores, and landing pages that help visitors understand your business and take the next step.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:cpu" aria-hidden="true" />
            <h3><a href="/services/design-development/#application-development">Custom Application Development</a></h3>
            <p>
              Give your team one place to manage daily work, share information with customers, and automate repeated tasks.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:megaphone" aria-hidden="true" />
            <h3><a href="/services/marketing-analytics/#marketing">Marketing</a></h3>
            <p>
              Search, paid advertising, social media, email, and content strategies to help the right customers find your business.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:bar-chart-2" aria-hidden="true" />
            <h3><a href="/services/marketing-analytics/#analytics-reporting">Analytics &amp; Reporting</a></h3>
            <p>
              Google Analytics setup, conversion tracking, and dashboards to help you understand which pages and campaigns bring inquiries.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:server" aria-hidden="true" />
            <h3><a href="/services/hosting-security/#hosting-infrastructure">Hosting &amp; Infrastructure</a></h3>
            <p>
              Domain management, hosting setup, performance improvements, and backup planning to support your website.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:shield" aria-hidden="true" />
            <h3><a href="/services/hosting-security/#security-maintenance">Security &amp; Maintenance</a></h3>
            <p>
              Updates, security checks, and uptime monitoring to help you keep your website maintained after launch.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:palette" aria-hidden="true" />
            <h3><a href="/services/branding-consulting/#branding-design">Branding &amp; Design</a></h3>
            <p>
              Logos, brand guides, and print and digital assets to give your business a consistent visual identity.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:compass" aria-hidden="true" />
            <h3><a href="/services/branding-consulting/#consulting-strategy">Consulting &amp; Strategy</a></h3>
            <p>
              Choose platforms that fit your business, plan a migration, or work out what your next software project needs.
            </p>
          </article>
        </div>
        <p class="services-more">
          See the full breakdown on our <a href="/services/">services page</a>, browse
          <a href="/work/">recent projects</a> in our portfolio, or read more
          <a href="/about/">about Stone Dragon Media</a> and the
          <a href="/products/">products we build</a>.
        </p>
      </section>

      <section class="section" id="recent-work">
        <h2 class="section-title">Recent Work</h2>
        <div class="work-shots">
          <a class="shot" href="/work/#simon-rook">
            <img src="/work/simonrook.webp" alt="Simon Rook author website" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Simon Rook</span>
            <span class="shot-desc">Author website with book details and purchase links.</span>
          </a>
          <a class="shot" href="/work/#firelands-current">
            <img src="/work/firelands-current.webp" alt="Firelands Current homepage with its teal masthead and local news headlines" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Firelands Current</span>
            <span class="shot-desc">Our local newspaper with events, reader discussions, and newsroom tools.</span>
          </a>
          <a class="shot" href="/work/#pneumaris">
            <img src="/work/pneumaris.webp" alt="Pneumaris band website" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Pneumaris</span>
            <span class="shot-desc">Band website with music players and a contact form.</span>
          </a>
          <a class="shot" href="/work/#tagstash">
            <img src="/work/tagstash.webp" alt="Tagstash bookmarking tool" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Tagstash</span>
            <span class="shot-desc">Our bookmarking application with paid plans and a Firefox extension.</span>
          </a>
        </div>
      </section>
    </div>

    <section class="band" id="areas-served">
      <div class="band-inner">
        <h2>Areas We Serve</h2>
        <p>
          Stone Dragon Media is based in Sandusky, Ohio. We work on site with businesses across
          Sandusky, Erie County, and the surrounding communities:
        </p>
        <ul class="areas-list">
          <li>Sandusky</li>
          <li>Huron</li>
          <li>Castalia</li>
          <li>Milan</li>
          <li>Berlin Heights</li>
          <li>Vermilion</li>
          <li>Wakeman</li>
          <li>Norwalk</li>
          <li>Monroeville</li>
          <li>Bellevue</li>
          <li>Clyde</li>
          <li>Willard</li>
          <li>New London</li>
          <li>Fremont</li>
          <li>Tiffin</li>
          <li>Port Clinton</li>
          <li>Marblehead</li>
          <li>Catawba Island</li>
          <li>Oak Harbor</li>
          <li>Kelleys Island</li>
          <li>Put-in-Bay</li>
          <li>Amherst</li>
          <li>Oberlin</li>
        </ul>
        <p>
          We also meet clients in person within about an hour&rsquo;s drive &mdash; Toledo to the
          west, Cleveland to the east, and the Lorain and Elyria corridor in between. Farther out,
          including Columbus, Akron, Canton, and Lima, we work remotely, as we do with clients
          anywhere in the US.
        </p>
      </div>
    </section>
    <div class="page">
      <section class="section">
        <h2 class="section-title">Tell us about your project</h2>
        <p>Tell us about your website, application, or the problem you need help solving. We&rsquo;ll follow up within one business day. Consultations are free.</p>
        <a class="button button-primary" href="/contact/">Discuss Your Project</a>
      </section>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
