---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialProfileUrls } from "../lib/social";

export const prerender = true;

const currentYear = new Date().getFullYear();
const codingStartYear = 1998;
const yearsExperience = currentYear - codingStartYear;
---

<BaseLayout
  title="Web Design in Sandusky, Ohio | Stone Dragon Media"
  description="Stone Dragon Media is a Sandusky, Ohio web design agency serving Erie County and the surrounding area â€” and remote clients anywhere. Custom web solutions, development, and digital marketing."
  canonical="https://stonedragonmedia.com/"
  ogUrl="https://stonedragonmedia.com/"
  ogImage="https://stonedragonmedia.com/header-bg.webp"
  ogImageAlt="Stone Dragon Media â€” custom web design and digital strategy in Sandusky, Ohio"
  includeGenerator={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness"],
      "name": "Stone Dragon Media",
      "url": "https://stonedragonmedia.com",
      "logo": "https://stonedragonmedia.com/logo.png",
      "image": "https://stonedragonmedia.com/logo.png",
      "description": "Stone Dragon Media builds custom web solutions, application development, digital marketing, and consulting services for growing businesses.",
      "telephone": "+1-567-450-0960",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sandusky",
        "addressRegion": "OH",
        "addressCountry": "US"
      },
      "areaServed": [
        "Sandusky, OH",
        "Erie County, OH",
        "Huron, OH",
        "Castalia, OH",
        "Milan, OH",
        "Berlin Heights, OH",
        "Vermilion, OH",
        "Wakeman, OH",
        "Norwalk, OH",
        "Monroeville, OH",
        "Bellevue, OH",
        "Clyde, OH",
        "Willard, OH",
        "New London, OH",
        "Fremont, OH",
        "Tiffin, OH",
        "Port Clinton, OH",
        "Marblehead, OH",
        "Catawba Island, OH",
        "Oak Harbor, OH",
        "Kelleys Island, OH",
        "Put-in-Bay, OH",
        "Amherst, OH",
        "Oberlin, OH",
        "Toledo, OH",
        "Cleveland, OH",
        "Lorain, OH",
        "Elyria, OH",
        "US"
      ],
      "sameAs": socialProfileUrls
    })} />
    <style>
      /* 4 x 2 on wide screens, so all eight services read as one block. */
      .services {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
      }

      .services .card {
        min-height: 12.5rem;
      }

      .services .card p {
        font-size: 0.97rem;
      }

      .services-more {
        max-width: 68ch;
        margin: 1.4rem 0 0;
      }

      .work-shots {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .areas-list {
        columns: 5 11rem;
        column-gap: 2rem;
        margin: 1.6rem 0 1.8rem;
        padding: 1.4rem 0;
        list-style: none;
        border-top: 1px solid rgba(169, 193, 212, 0.25);
        border-bottom: 1px solid rgba(169, 193, 212, 0.25);
      }

      .areas-list li {
        padding: 0.2rem 0;
        font-weight: 600;
        color: #fff;
        break-inside: avoid;
      }

      @media (max-width: 1100px) {
        .services,
        .work-shots {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 640px) {
        .services {
          grid-template-columns: 1fr;
        }

        .services .card {
          min-height: 0;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="home" showCta={true} />

  <main id="main-content">
    <PageHero
      tall
      image="/header-bg.webp"
      alt="Stone Dragon Media — custom web design and digital strategy agency based in Sandusky, Ohio"
      title="Sandusky, Ohio web design for growing brands"
      desc={`Custom web solutions, application development, hosting, and consulting to help businesses scale online. Based in Sandusky, Ohio, with ${yearsExperience} years of IT and development experience.`}
      position="center 35%"
    >
      <a class="button button-primary" href="/contact/">
        <Icon class="icon" name="lucide:calendar-check-2" aria-hidden="true" />
        Book Discovery Call
      </a>
      <a class="button button-secondary" href="/services/">View Services</a>
    </PageHero>

    <div class="page">
      <section class="section" id="services">
        <h2 class="section-title">Our Web Design &amp; Digital Services</h2>
        <div class="services">
          <article class="card">
            <Icon class="icon" name="lucide:layout-template" aria-hidden="true" />
            <h3><a href="/services/design-development/#custom-web-solutions">Custom Web Solutions</a></h3>
            <p>
              eCommerce sites, informational websites, landing pages, and custom business solutions built fast and built to last.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:cpu" aria-hidden="true" />
            <h3><a href="/services/design-development/#application-development">Custom Application Development</a></h3>
            <p>
              Internal tools, customer portals, workflow automation, and API integrations tailored to your operations.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:megaphone" aria-hidden="true" />
            <h3><a href="/services/marketing-analytics/#marketing">Marketing</a></h3>
            <p>
              SEO, PPC, social media, email, and content strategies that drive qualified traffic and measurable growth.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:bar-chart-2" aria-hidden="true" />
            <h3><a href="/services/marketing-analytics/#analytics-reporting">Analytics &amp; Reporting</a></h3>
            <p>
              GA4 setup, conversion tracking, custom dashboards, and performance audits to turn data into decisions.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:server" aria-hidden="true" />
            <h3><a href="/services/hosting-security/#hosting-infrastructure">Hosting &amp; Infrastructure</a></h3>
            <p>
              Domain management, cloud and VPS server setup, SSL, performance optimization, and backup planning.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:shield" aria-hidden="true" />
            <h3><a href="/services/hosting-security/#security-maintenance">Security &amp; Maintenance</a></h3>
            <p>
              Ongoing site care including security hardening, updates, uptime monitoring, and vulnerability assessments.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:palette" aria-hidden="true" />
            <h3><a href="/services/branding-consulting/#branding-design">Branding &amp; Design</a></h3>
            <p>
              Logo design, brand style guides, color and typography systems, and print and digital asset creation.
            </p>
          </article>
          <article class="card">
            <Icon class="icon" name="lucide:compass" aria-hidden="true" />
            <h3><a href="/services/branding-consulting/#consulting-strategy">Consulting &amp; Strategy</a></h3>
            <p>
              Technology selection, digital transformation planning, data migration, and project roadmapping.
            </p>
          </article>
        </div>
        <p class="services-more">
          See the full breakdown on our <a href="/services/">services page</a>, browse
          <a href="/work/">recent projects</a> in our portfolio, or read more
          <a href="/about/">about Stone Dragon Media</a> and the
          <a href="/products/">products we build</a>.
        </p>
      </section>

      <section class="section" id="recent-work">
        <h2 class="section-title">Recent Work</h2>
        <div class="work-shots">
          <a class="shot" href="/work/#simon-rook">
            <img src="/work/simonrook.webp" alt="Simon Rook author website" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Simon Rook</span>
          </a>
          <a class="shot" href="/work/#dorian-black">
            <img src="/work/dorianblack.webp" alt="Dorian Black synth-pop artist website" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Dorian Black</span>
          </a>
          <a class="shot" href="/work/#pneumaris">
            <img src="/work/pneumaris.webp" alt="Pneumaris band website" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Pneumaris</span>
          </a>
          <a class="shot" href="/work/#tagstash">
            <img src="/work/tagstash.webp" alt="Tagstash bookmarking tool" loading="lazy" width="1180" height="615" />
            <span class="shot-name">Tagstash</span>
          </a>
        </div>
      </section>
    </div>

    <section class="band" id="areas-served">
      <div class="band-inner">
        <h2>Areas We Serve</h2>
        <p>
          Stone Dragon Media is based in Sandusky, Ohio. We work on site with businesses across
          Sandusky, Erie County, and the surrounding communities:
        </p>
        <ul class="areas-list">
          <li>Sandusky</li>
          <li>Huron</li>
          <li>Castalia</li>
          <li>Milan</li>
          <li>Berlin Heights</li>
          <li>Vermilion</li>
          <li>Wakeman</li>
          <li>Norwalk</li>
          <li>Monroeville</li>
          <li>Bellevue</li>
          <li>Clyde</li>
          <li>Willard</li>
          <li>New London</li>
          <li>Fremont</li>
          <li>Tiffin</li>
          <li>Port Clinton</li>
          <li>Marblehead</li>
          <li>Catawba Island</li>
          <li>Oak Harbor</li>
          <li>Kelleys Island</li>
          <li>Put-in-Bay</li>
          <li>Amherst</li>
          <li>Oberlin</li>
        </ul>
        <p>
          We also meet clients in person within about an hour&rsquo;s drive &mdash; Toledo to the
          west, Cleveland to the east, and the Lorain and Elyria corridor in between. Farther out,
          including Columbus, Akron, Canton, and Lima, we work remotely, as we do with clients
          anywhere in the US.
        </p>
      </div>
    </section>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
