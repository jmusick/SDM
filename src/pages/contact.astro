---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Contact a Sandusky, OH Web Designer | Stone Dragon Media"
  description="Discuss your website or application with Stone Dragon Media in Sandusky, Ohio. Free consultations and a response within one business day."
  canonical="https://stonedragonmedia.com/contact/"
  ogUrl="https://stonedragonmedia.com/contact/"
  breadcrumb="Contact"
  ogImage="https://stonedragonmedia.com/contact-bg.webp"
  ogImageAlt="Contact Stone Dragon Media — start a project or ask about our services"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Contact Stone Dragon Media",
      "url": "https://stonedragonmedia.com/contact/",
      "mainEntity": {
        "@type": "Organization",
        "name": "Stone Dragon Media",
        "url": "https://stonedragonmedia.com",
        "telephone": "+1-567-450-0960",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Sandusky",
          "addressRegion": "OH",
          "addressCountry": "US"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+1-567-450-0960",
          "contactType": "sales",
          "areaServed": "US",
          "availableLanguage": "English"
        }
      }
    })} />
    <style>
      .contact-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 22rem;
        gap: clamp(1.5rem, 3vw, 2.5rem);
        align-items: start;
      }

      .form-card {
        padding: clamp(1.4rem, 3vw, 2.2rem);
      }

      .form-card h2 {
        margin: 0 0 0.4rem;
        font-size: clamp(1.4rem, 2.4vw, 1.8rem);
      }

      .form-card .form-intro {
        margin: 0 0 0.5rem;
        color: var(--ink);
      }

      .required-note {
        margin: 0 0 1.2rem;
        font-size: 0.88rem;
      }

      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      .field.full {
        grid-column: 1 / -1;
      }

      .required-mark {
        color: var(--lake);
      }

      label {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--slate);
      }

      /* Border is #7d8d9a for 3:1 against the white field — the WCAG minimum for input edges. */
      input,
      select,
      textarea {
        width: 100%;
        border: 1px solid #7d8d9a;
        background: #fff;
        border-radius: 3px;
        padding: 0.7rem 0.8rem;
        font: inherit;
        font-size: 1rem;
        color: var(--ink);
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: var(--lake);
      }

      textarea {
        min-height: 150px;
        resize: vertical;
      }

      .hcaptcha-wrap {
        margin-top: 1rem;
      }

      .submit-row {
        margin-top: 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .helper {
        margin: 0;
        font-size: 0.9rem;
      }

      .form-status {
        margin-top: 1rem;
        padding: 0.7rem 0.85rem;
        border-left: 3px solid;
        font-size: 0.95rem;
      }

      .form-status.success {
        background: rgba(12, 117, 58, 0.1);
        border-color: #0b5f33;
        color: #0b5f33;
      }

      .form-status.error {
        background: rgba(173, 38, 38, 0.1);
        border-color: #7d2121;
        color: #7d2121;
      }

      /* One card, items divided by seams, rather than a stack of five separate boxes. */
      .info-panel {
        padding: 0.4rem 1.5rem;
      }

      .info-item {
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
        padding: 1.1rem 0;
      }

      .info-item + .info-item {
        border-top: 1px solid var(--seam);
      }

      .info-icon {
        width: 1.15rem;
        height: 1.15rem;
        color: var(--lake);
        flex-shrink: 0;
        margin-top: 0.2rem;
      }

      .info-item h2 {
        margin: 0 0 0.25rem;
        font-size: 1.02rem;
      }

      .info-item h2 a {
        color: inherit;
        text-decoration: none;
      }

      .info-item h2 a:hover {
        color: var(--lake);
        text-decoration: underline;
      }

      .info-item p {
        font-size: 0.94rem;
        line-height: 1.5;
      }

      @media (max-width: 920px) {
        .contact-layout {
          grid-template-columns: 1fr;
        }

        .form-grid {
          grid-template-columns: 1fr;
        }

        .submit-row {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="contact" />

  <main id="main-content">
    <PageHero
      image="/contact-bg.webp"
      alt="Contact Stone Dragon Media — start a project or ask about our services"
      title="Contact a Sandusky, Ohio Web Designer"
      desc="Tell us what you need help with. We’ll follow up within one business day to discuss your project. Consultations are free, with no obligation."
      crumbs={[{ name: "Contact" }]}
      position="center 70%"
    />

    <div class="page">
      <div class="contact-layout">
        <div class="card form-card">
          <h2>Tell Us About Your Project</h2>
          <p class="form-intro">A few details are enough to start the conversation.</p>
          <p class="required-note">Fields marked with <span aria-hidden="true">*</span> are required.</p>
          <form id="contact-form" method="post" action="https://api.web3forms.com/submit">
            <input type="hidden" name="access_key" value="8b9f961f-4a2f-43bc-938a-11f26885cd31" />
            <div class="form-grid">
              <div class="field">
                <label for="name">Name <span class="required-mark" aria-hidden="true">*</span></label>
                <input id="name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="email">Email <span class="required-mark" aria-hidden="true">*</span></label>
                <input id="email" name="email" type="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="company">Company</label>
                <input id="company" name="company" type="text" autocomplete="organization" />
              </div>
              <div class="field">
                <label for="timeline">Timeline</label>
                <select id="timeline" name="timeline">
                  <option>As soon as possible</option>
                  <option>Within 30 days</option>
                  <option>1-3 months</option>
                  <option>Exploring options</option>
                </select>
              </div>
              <div class="field full">
                <label for="message">Project Details <span class="required-mark" aria-hidden="true">*</span></label>
                <textarea id="message" name="message" placeholder="What does your business need? Tell us about your current website or the project you have in mind." required></textarea>
              </div>
            </div>
            <div class="hcaptcha-wrap">
              <div class="h-captcha" data-sitekey="50b2fe65-b00b-4b9e-ad62-3ba471098be2"></div>
            </div>
            <div class="submit-row">
              <p class="helper">Still exploring? You&rsquo;re welcome to ask a question.</p>
              <button id="contact-submit" class="button button-primary" type="submit">
                <Icon class="icon" name="lucide:send" aria-hidden="true" />
                Send Message
              </button>
            </div>
            <div id="contact-form-status" class="form-status" role="status" aria-live="polite" hidden></div>
          </form>
        </div>

        <aside class="card info-panel" aria-label="Contact details">
          <div class="info-item">
            <Icon class="info-icon" name="lucide:map-pin" aria-hidden="true" />
            <div>
              <h2>Sandusky, OH</h2>
              <p>Serving Sandusky, Erie County, and the surrounding area in person, plus remote clients anywhere.</p>
            </div>
          </div>
          <div class="info-item">
            <Icon class="info-icon" name="lucide:phone" aria-hidden="true" />
            <div>
              <h2><a href="tel:+15674500960">(567) 450-0960</a></h2>
              <p>Call or text to talk through your project.</p>
            </div>
          </div>
          <div class="info-item">
            <Icon class="info-icon" name="lucide:clock" aria-hidden="true" />
            <div>
              <h2>Quick Response</h2>
              <p>We follow up on all inquiries within one business day.</p>
            </div>
          </div>
          <div class="info-item">
            <Icon class="info-icon" name="lucide:shield-check" aria-hidden="true" />
            <div>
              <h2>No Obligation</h2>
              <p>Consultations are free. No pressure, no commitments required.</p>
            </div>
          </div>
          <div class="info-item">
            <Icon class="info-icon" name="lucide:layers" aria-hidden="true" />
            <div>
              <h2>Full-Service</h2>
              <p>Help with planning, design, development, and ongoing support.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
  <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const submitButton = document.getElementById("contact-submit") as HTMLButtonElement | null;
    const statusMessage = document.getElementById("contact-form-status") as HTMLDivElement | null;
    const originalButtonHtml = submitButton?.innerHTML;

    const setStatus = (type: "success" | "error", message: string) => {
      if (!statusMessage) return;
      statusMessage.hidden = false;
      statusMessage.className = `form-status ${type}`;
      statusMessage.textContent = message;
    };

    if (!form || !submitButton || !statusMessage) {
      throw new Error("Contact form elements are missing.");
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
      statusMessage.hidden = true;

      try {
        const hcaptcha = (window as Window & { hcaptcha?: { getResponse: () => string; reset: () => void } }).hcaptcha;
        const captchaResponse = hcaptcha?.getResponse();
        if (!captchaResponse) {
          setStatus("error", "Please complete the CAPTCHA.");
          return;
        }

        const formData = new FormData(form);
        const payload = {
          access_key: formData.get("access_key"),
          name: formData.get("name"),
          email: formData.get("email"),
          company: formData.get("company"),
          timeline: formData.get("timeline"),
          message: formData.get("message"),
          "h-captcha-response": captchaResponse,
        };

        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const result = (await response.json()) as { success?: boolean; message?: string };
        if (result.success) {
          const analytics = (window as Window & {
            gtag?: (...args: unknown[]) => void;
          }).gtag;

          if (analytics) {
            let redirected = false;
            const showThankYou = () => {
              if (redirected) return;
              redirected = true;
              window.location.href = "/thank-you/";
            };

            analytics("event", "generate_lead", {
              event_category: "engagement",
              event_label: "contact_form",
              transport_type: "beacon",
              event_callback: showThankYou,
            });
            window.setTimeout(showThankYou, 1200);
            return;
          }

          window.location.href = "/thank-you/";
          return;
        } else {
          setStatus("error", "We couldn’t send your message. Please try again, or call or text (567) 450-0960.");
        }
      } catch {
        setStatus("error", "We couldn’t send your message. Please try again, or call or text (567) 450-0960.");
      } finally {
        submitButton.disabled = false;
        submitButton.innerHTML = originalButtonHtml ?? "Send Message";
      }
    });
  </script>
</BaseLayout>
