---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Digital Products & Publications | Stone Dragon Media"
  description="Discover Firelands Current, our digital newspaper for Sandusky and the Firelands, and Tagstash, our tag-first bookmarking tool."
  canonical="https://stonedragonmedia.com/products/"
  ogUrl="https://stonedragonmedia.com/products/"
  breadcrumb="Products"
  ogImage="https://stonedragonmedia.com/products-header.webp"
  ogImageAlt="Stone Dragon Media products — digital publications and practical tools"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Digital Products & Publications",
      "url": "https://stonedragonmedia.com/products/",
      "about": [
        {
          "@type": "WebSite",
          "name": "Firelands Current",
          "url": "https://firelandscurrent.com/",
          "description": "Independent digital newspaper for Sandusky, Ohio, and the Firelands region, owned and operated by Stone Dragon Media, LLC. Local news, an events calendar, and reader discussions.",
          "image": "https://stonedragonmedia.com/work/firelands-current.webp",
          "creator": { "@type": "Organization", "name": "Stone Dragon Media, LLC", "url": "https://stonedragonmedia.com/" },
          "publisher": { "@type": "Organization", "name": "Stone Dragon Media, LLC", "url": "https://stonedragonmedia.com/" }
        },
        {
          "@type": "SoftwareApplication",
          "name": "Tagstash",
          "url": "https://tagsta.sh/",
          "description": "Tag-first bookmarking and reference tool for capturing, tagging, and retrieving links without folder trees. Includes accounts, bookmark import, public profile pages, and a companion Firefox extension.",
          "image": "https://stonedragonmedia.com/work/tagstash.webp",
          "applicationCategory": "BrowserApplication",
          "operatingSystem": "Web",
          "publisher": {
            "@type": "Organization",
            "name": "Stone Dragon Media",
            "url": "https://stonedragonmedia.com"
          }
        }
      ]
    })} />
    <style>
      /* Copy on the left, the product screenshot on the right; they stack on narrow screens. */
      .product {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: start;
      }

      .product + .product {
        margin-top: clamp(3rem, 6vw, 5rem);
        padding-top: clamp(2rem, 4vw, 3rem);
        border-top: 1px solid var(--seam);
      }

      .product h2 {
        margin: 0 0 0.8rem;
        font-size: clamp(1.8rem, 3.4vw, 2.6rem);
        color: var(--slate);
      }

      .product p {
        margin: 0;
      }

      .product-intro {
        font-size: 1.12rem;
      }

      .product ul {
        margin: 1.2rem 0 0;
        padding-left: 1.15rem;
        color: var(--ink-soft);
      }

      .product li {
        margin: 0 0 0.4rem;
        line-height: 1.5;
      }

      .product .product-note {
        margin-top: 1.2rem;
      }

      .product-media {
        position: sticky;
        top: 1.5rem;
      }

      .product-media img {
        display: block;
        width: 100%;
        height: auto;
        background: var(--slate);
        clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%);
      }

      .actions {
        margin-top: 1.6rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      @media (max-width: 920px) {
        .product {
          grid-template-columns: 1fr;
        }

        .product-media {
          position: static;
          order: -1;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="products" />

  <main id="main-content">
    <PageHero
      image="/products-header.webp"
      alt="Stone Dragon Media products — digital publications and practical tools"
      title="Digital Products & Publications"
      desc="Built and run by Stone Dragon Media, from local news to tools for organizing your work."
      crumbs={[{ name: "Products" }]}
      position="center 70%"
    />

    <div class="page">
      <section class="product" id="firelands-current" aria-labelledby="firelands-current-title">
        <div class="product-copy">
          <h2 id="firelands-current-title">Firelands Current</h2>
          <p class="product-intro">
            Firelands Current is our independent digital newspaper for Sandusky, Ohio, and
            the surrounding Firelands region. Stone Dragon Media, LLC owns and operates
            the publication, bringing local reporting, an events calendar, and community
            conversation together in one place.
          </p>
          <ul>
            <li>Read local coverage of government, business, schools, community life, and the outdoors</li>
            <li>Find upcoming events by category and community, and add them to your calendar</li>
            <li>Join Talk of the Town to discuss stories and events or start a conversation with neighbors</li>
            <li>Follow writers through their public profiles and keep up with stories through RSS</li>
            <li>Send a news tip or ask about advertising to reach readers across the region</li>
          </ul>
          <p class="product-note">
            We built the publishing platform and run the newspaper. See the
            <a href="/work/#firelands-current">design and development breakdown</a> in our portfolio.
          </p>
          <div class="actions">
            <a class="button button-primary" href="https://firelandscurrent.com/" target="_blank" rel="noreferrer noopener" aria-label="Read Firelands Current (opens in a new tab)">
              <Icon class="icon" name="lucide:external-link" aria-hidden="true" />
              Read Firelands Current
            </a>
            <a class="button button-secondary" href="https://firelandscurrent.com/advertise" target="_blank" rel="noreferrer noopener" aria-label="Advertise on Firelands Current (opens in a new tab)">
              Advertise on Firelands Current
            </a>
          </div>
        </div>
        <div class="product-media">
          <img src="/work/firelands-current.webp" alt="Firelands Current homepage with its teal masthead and local news headlines" loading="lazy" width="1180" height="615" />
        </div>
      </section>
      <section class="product" id="tagstash" aria-labelledby="tagstash-title">
        <div class="product-copy">
          <h2 id="tagstash-title">Tagstash</h2>
          <p class="product-intro">
            Tagstash is a tag-first bookmarking and reference tool designed to make it easy to capture,
            tag, and retrieve important links fast &mdash; no folder trees to maintain, and no digging
            through a browser bookmark bar to find the one page you saved last month.
          </p>
          <ul>
            <li>Add multiple tags to each bookmark so you can find it by topic, project, or purpose</li>
            <li>Free and Pro plans, with billing handled securely through Stripe</li>
            <li>Accounts with email verification</li>
            <li>Bookmark import and management for everything you have already collected</li>
            <li>Public profile pages for sharing a collection of links</li>
            <li>Save pages in one click with the Firefox extension. Browse, search, edit, and tag bookmarks from its sidebar</li>
          </ul>
          <p class="product-note">
            Tagstash is built and run entirely in house &mdash; see the <a href="/work/#tagstash">build
            breakdown</a> alongside our client work.
          </p>
          <div class="actions">
            <a class="button button-primary" href="https://tagsta.sh/" target="_blank" rel="noreferrer noopener">
              <Icon class="icon" name="lucide:external-link" aria-hidden="true" />
              Visit Tagstash
            </a>
            <a class="button button-secondary" href="/contact/">
              Ask About Product Development
            </a>
          </div>
        </div>
        <div class="product-media">
          <img
            src="/work/tagstash.webp"
            alt="The Tagstash web app showing tag-first bookmark organization and search"
            loading="lazy"
            width="1180"
            height="615"
          />
        </div>
      </section>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
