---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Products: Tagstash Bookmarking Tool | Stone Dragon Media"
  description="Explore products built by Stone Dragon Media, including Tagstash — a modern bookmarking and resource organization tool built for productivity."
  canonical="https://stonedragonmedia.com/products/"
  ogUrl="https://stonedragonmedia.com/products/"
  breadcrumb="Products"
  ogImage="https://stonedragonmedia.com/products-header.webp"
  ogImageAlt="Stone Dragon Media products — practical tools for productivity and workflow"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Tagstash",
      "url": "https://tagsta.sh/",
      "description": "Tag-first bookmarking and reference tool for capturing, tagging, and retrieving links without folder trees. Includes accounts, bookmark import, public profile pages, and a companion Firefox extension.",
      "image": "https://stonedragonmedia.com/work/tagstash.webp",
      "applicationCategory": "BrowserApplication",
      "operatingSystem": "Web",
      "publisher": {
        "@type": "Organization",
        "name": "Stone Dragon Media",
        "url": "https://stonedragonmedia.com"
      }
    })} />
    <style>
      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem clamp(1.1rem, 2.5vw, 2.4rem) 0;
      }

      .footer-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 clamp(1.1rem, 2.5vw, 2.4rem) 4rem;
      }

      .header-hero {
        position: relative;
        width: 100vw;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        height: 520px;
        max-width: 100vw;
        border-radius: 0;
        overflow: hidden;
        box-shadow: none;
        margin-bottom: 1rem;
        background: #122238;
      }

      .header-hero img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        object-position: center 70%;
      }

      .header-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 3.5rem 3.5rem 3.5rem max(8vw, calc((100vw - 1280px) / 2 + clamp(1.1rem, 2.5vw, 2.4rem)));
        color: #fff;
        background: linear-gradient(90deg, rgba(18, 34, 56, 0.82) 0%, rgba(18, 34, 56, 0.32) 60%, rgba(18, 34, 56, 0) 100%);
        font-family: "Sora", sans-serif;
        pointer-events: none;
        box-sizing: border-box;
      }

      .header-overlay .about-label {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.13em;
        margin-bottom: 0.7rem;
        opacity: 0.92;
        border-bottom: 3px solid #7fa6d9;
        display: inline-block;
        padding-bottom: 0.2rem;
      }

      .header-overlay .hero-title {
        font-size: 2.8rem;
        font-weight: 800;
        margin-bottom: 1.2rem;
        line-height: 1.1;
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
      }

      .header-overlay .hero-desc {
        font-size: 1.25rem;
        font-weight: 400;
        max-width: 32rem;
        line-height: 1.5;
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
      }

      h1 {
        font-family: "Sora", sans-serif;
        color: var(--brand-strong);
        margin: 0 0 1rem;
      }

      .lead {
        color: var(--ink-soft);
        max-width: 70ch;
      }

      .product {
        margin-top: 1.2rem;
        border: 1px solid var(--line);
        background: var(--surface);
        border-radius: 1rem;
        padding: 1.2rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(239, 247, 253, 0.9);
        color: var(--brand-strong);
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.35rem 0.65rem;
      }

      .badge .icon {
        width: 0.92rem;
        height: 0.92rem;
      }

      h2 {
        margin: 0.85rem 0 0.45rem;
        color: var(--brand-strong);
        font-family: "Sora", sans-serif;
      }

      .product p {
        color: var(--ink-soft);
        line-height: 1.6;
        margin: 0;
      }

      .product-media {
        margin: 1.1rem 0 0;
        border: 1px solid var(--line);
        border-radius: 0.8rem;
        overflow: hidden;
        background: #122238;
      }

      .product-media img {
        width: 100%;
        height: auto;
        display: block;
      }

      .product ul {
        margin: 1.1rem 0 0;
        padding-left: 1.15rem;
        color: var(--ink-soft);
        line-height: 1.6;
      }

      .product li {
        margin: 0 0 0.35rem;
      }

      .product .product-note {
        margin-top: 1.1rem;
      }

      .actions {
        margin-top: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        font-family: "Sora", sans-serif;
        padding: 0.65rem 1rem;
        border-radius: 0.75rem;
        font-weight: 600;
        border: 1px solid transparent;
      }

      .button .icon {
        width: 1rem;
        height: 1rem;
        margin-right: 0.4rem;
      }

      .button-primary {
        color: #edf6ff;
        background: linear-gradient(125deg, #1f5a89, #2f709f);
      }

      .button-secondary {
        color: var(--brand-strong);
        background: rgba(239, 247, 253, 0.86);
        border-color: rgba(43, 90, 124, 0.4);
      }

      .site-footer {
        margin-top: 2rem;
      }

      @media (max-width: 920px) {
        .header-overlay {
          padding: 2rem 1.2rem 2rem 1.2rem;
          align-items: flex-start;
        }

        .header-overlay .hero-title {
          font-size: 2rem;
        }

        .header-overlay .hero-desc {
          font-size: 1rem;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="products" />

  <div class="header-hero">
    <img src="/products-header.webp" alt="Stone Dragon Media products — practical tools for productivity and workflow" />
    <div class="header-overlay">
      <span class="about-label">PRODUCTS</span>
      <span class="hero-title">Our Products</span>
      <span class="hero-desc">
        Practical tools designed to solve real workflow problems and boost productivity.
      </span>
    </div>
  </div>

  <main class="page">
    <h1>Products Built by Stone Dragon Media</h1>
    <p class="lead">Stone Dragon Media builds practical products that solve real workflow problems.</p>
    <section class="product" aria-label="Featured product">
      <div class="badge">
        <Icon class="icon" name="lucide:star" aria-hidden="true" />
        Featured Product
      </div>
      <h2>Tagstash</h2>
      <p>
        Tagstash is a tag-first bookmarking and reference tool designed to make it easy to capture,
        tag, and retrieve important links fast &mdash; no folder trees to maintain, and no digging
        through a browser bookmark bar to find the one page you saved last month.
      </p>
      <div class="product-media">
        <img
          src="/work/tagstash.webp"
          alt="The Tagstash web app showing tag-first bookmark organization and search"
          loading="lazy"
          width="1180"
          height="615"
        />
      </div>
      <ul>
        <li>Tag-first organization, so a bookmark can live in as many contexts as it needs to</li>
        <li>Free and Pro plans, with billing handled securely through Stripe</li>
        <li>Accounts with email verification</li>
        <li>Bookmark import and management for everything you have already collected</li>
        <li>Public profile pages for sharing a collection of links</li>
        <li>A companion Firefox extension for one-click saving, plus a sidebar for browsing, searching, editing, and tagging without leaving the page</li>
      </ul>
      <p class="product-note">
        Tagstash is built and run entirely in house &mdash; see the <a href="/work/#tagstash">build
        breakdown</a> alongside our client work.
      </p>
      <div class="actions">
        <a class="button button-primary" href="https://tagsta.sh/" target="_blank" rel="noreferrer noopener">
          <Icon class="icon" name="lucide:external-link" aria-hidden="true" />
          Visit Tagstash
        </a>
        <a class="button button-secondary" href="/contact/">
          <Icon class="icon" name="lucide:messages-square" aria-hidden="true" />
          Ask About Product Development
        </a>
      </div>
    </section>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
