---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageBand from "../components/PageBand.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Products: Tagstash Bookmarking Tool | Stone Dragon Media"
  description="Explore products built by Stone Dragon Media, including Tagstash, a tag-first bookmarking tool for saving and finding links."
  canonical="https://stonedragonmedia.com/products/"
  ogUrl="https://stonedragonmedia.com/products/"
  breadcrumb="Products"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Tagstash",
      "url": "https://tagsta.sh/",
      "description": "Tag-first bookmarking and reference tool for capturing, tagging, and retrieving links without folder trees. Includes accounts, bookmark import, public profile pages, and a companion Firefox extension.",
      "image": "https://stonedragonmedia.com/work/tagstash.webp",
      "applicationCategory": "BrowserApplication",
      "operatingSystem": "Web",
      "publisher": {
        "@type": "Organization",
        "name": "Stone Dragon Media",
        "url": "https://stonedragonmedia.com"
      }
    })} />
    <style>
      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem clamp(1.1rem, 2.5vw, 2.4rem) 0;
      }

      .footer-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 clamp(1.1rem, 2.5vw, 2.4rem) 4rem;
      }

      .product {
        margin-top: 1.2rem;
        border: 1px solid var(--line);
        background: var(--surface);
        border-radius: 1rem;
        padding: 1.2rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(239, 247, 253, 0.9);
        color: var(--brand-strong);
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.35rem 0.65rem;
      }

      h2 {
        margin: 0.85rem 0 0.45rem;
        color: var(--brand-strong);
        font-family: "Sora", sans-serif;
      }

      .product p {
        color: var(--ink-soft);
        line-height: 1.6;
        margin: 0;
      }

      .product-media {
        margin: 1.1rem 0 0;
        border: 1px solid var(--line);
        border-radius: 0.8rem;
        overflow: hidden;
        background: #122238;
      }

      .product-media img {
        width: 100%;
        height: auto;
        display: block;
      }

      .product ul {
        margin: 1.1rem 0 0;
        padding-left: 1.15rem;
        color: var(--ink-soft);
        line-height: 1.6;
      }

      .product li {
        margin: 0 0 0.35rem;
      }

      .product .product-note {
        margin-top: 1.1rem;
      }

      .actions {
        margin-top: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        font-family: "Sora", sans-serif;
        padding: 0.65rem 1rem;
        border-radius: 0.75rem;
        font-weight: 600;
        border: 1px solid transparent;
      }

      .button .icon {
        width: 1rem;
        height: 1rem;
        margin-right: 0.4rem;
      }

      .button-primary {
        color: #edf6ff;
        background: linear-gradient(125deg, #1f5a89, #2f709f);
      }

      .button-secondary {
        color: var(--brand-strong);
        background: rgba(239, 247, 253, 0.86);
        border-color: rgba(43, 90, 124, 0.4);
      }

      .site-footer {
        margin-top: 2rem;
      }

    </style>
  </Fragment>

  <SiteHeader active="products" />

  <main class="page" id="main-content">
    <PageBand title="Products Built by Stone Dragon Media" description="Tools we build and run ourselves, starting with Tagstash." />
    <section class="product" aria-label="Featured product">
      <div class="badge">
        Featured Product
      </div>
      <h2>Tagstash</h2>
      <p>
        Tagstash is a tag-first bookmarking and reference tool for capturing,
        tag, and retrieve important links fast. There are no folder trees to maintain and no digging
        through a browser bookmark bar to find the one page you saved last month.
      </p>
      <div class="product-media">
        <img
          src="/work/tagstash.webp"
          alt="The Tagstash web app showing tag-first bookmark organization and search"
          loading="lazy"
          width="1180"
          height="615"
        />
      </div>
      <ul>
        <li>Tag-first organization, so a bookmark can live in as many contexts as it needs to</li>
        <li>Free and Pro plans, with billing handled securely through Stripe</li>
        <li>Accounts with email verification</li>
        <li>Bookmark import and management for everything you have already collected</li>
        <li>Public profile pages for sharing a collection of links</li>
        <li>A companion Firefox extension for one-click saving, plus a sidebar for browsing, searching, editing, and tagging without leaving the page</li>
      </ul>
      <p class="product-note">
        Tagstash is built and run entirely in house. See the <a href="/work/#tagstash">build
        breakdown</a> alongside our client work.
      </p>
      <div class="actions">
        <a class="button button-primary" href="https://tagsta.sh/" target="_blank" rel="noreferrer noopener">
          Visit Tagstash
        </a>
        <a class="button button-secondary" href="/contact/">
          Ask About Product Development
        </a>
      </div>
    </section>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
