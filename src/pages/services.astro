---
import { Icon } from "astro-icon/components";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

// Names and descriptions here must match the visible cards below — they feed the Service JSON-LD.
// If a card's heading or summary changes, change it here too.
const schemaServices = [
  ["Custom Web Solutions", "Custom websites and web systems built to communicate value, drive action, and stay lightning fast.", "custom-web-solutions"],
  ["Custom Application Development", "Tailored software solutions built around your workflow, not the other way around.", "application-development"],
  ["Marketing", "Data-driven campaigns that put your business in front of the right audience at the right time.", "marketing"],
  ["Analytics & Reporting", "Turn your data into decisions with clear, actionable insight into how your digital presence is performing.", "analytics-reporting"],
  ["Hosting & Infrastructure", "Reliable, secure hosting environments configured for performance and peace of mind.", "hosting-infrastructure"],
  ["Security & Maintenance", "Proactive care to keep your site secure, up to date, and running smoothly long after launch.", "security-maintenance"],
  ["Branding & Design", "A cohesive visual identity that communicates who you are and builds trust with your audience.", "branding-design"],
  ["Consulting & Strategy", "Expert guidance to help you make confident decisions about technology, process, and digital growth.", "consulting-strategy"],
];
---

<BaseLayout
  title="Web Design Services in Sandusky, OH | Stone Dragon Media"
  description="Stone Dragon Media offers custom web solutions, application development, SEO, PPC, branding, hosting, and consulting services for businesses of all sizes."
  canonical="https://stonedragonmedia.com/services/"
  ogUrl="https://stonedragonmedia.com/services/"
  breadcrumb="Services"
  ogImage="https://stonedragonmedia.com/services-header.webp"
  ogImageAlt="Stone Dragon Media digital services — web design, development, marketing, and consulting"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Services offered by Stone Dragon Media",
      "itemListElement": schemaServices.map(([name, description, id], i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "Service",
          "name": name,
          "description": description,
          "url": `https://stonedragonmedia.com/services/#${id}`,
          "serviceType": name,
          "provider": {
            "@type": "Organization",
            "name": "Stone Dragon Media",
            "url": "https://stonedragonmedia.com"
          },
          "areaServed": { "@type": "AdministrativeArea", "name": "Erie County, OH" }
        }
      }))
    })} />
    <style>
      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1rem clamp(1.1rem, 2.5vw, 2.4rem) 0;
      }

      .footer-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 clamp(1.1rem, 2.5vw, 2.4rem) 4rem;
      }

      .header-hero {
        position: relative;
        width: 100vw;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        height: 520px;
        max-width: 100vw;
        border-radius: 0;
        overflow: hidden;
        box-shadow: none;
        margin-bottom: 1rem;
        background: #122238;
      }

      .header-hero img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        object-position: center 70%;
      }

      .header-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 3.5rem 3.5rem 3.5rem max(8vw, calc((100vw - 1280px) / 2 + clamp(1.1rem, 2.5vw, 2.4rem)));
        color: #fff;
        background: linear-gradient(90deg, rgba(18, 34, 56, 0.82) 0%, rgba(18, 34, 56, 0.32) 60%, rgba(18, 34, 56, 0) 100%);
        font-family: "Sora", sans-serif;
        pointer-events: none;
        box-sizing: border-box;
      }

      .header-overlay .about-label {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.13em;
        margin-bottom: 0.7rem;
        opacity: 0.92;
        border-bottom: 3px solid #7fa6d9;
        display: inline-block;
        padding-bottom: 0.2rem;
      }

      .header-overlay .hero-title {
        font-size: 2.8rem;
        font-weight: 800;
        margin-bottom: 1.2rem;
        line-height: 1.1;
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
      }

      .header-overlay .hero-desc {
        font-size: 1.25rem;
        font-weight: 400;
        max-width: 32rem;
        line-height: 1.5;
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.18);
      }

      h1 {
        font-family: "Sora", sans-serif;
        color: var(--brand-strong);
        margin: 0 0 1rem;
      }

      .pricing > h2 {
        font-family: "Sora", sans-serif;
        color: var(--brand-strong);
        font-size: clamp(1.4rem, 2vw, 1.8rem);
        margin: 0 0 1rem;
      }

      .lead {
        color: var(--ink-soft);
        max-width: 70ch;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      /* The eight services are split into four labeled pairs so the page reads as groups
         rather than one uniform wall of cards. */
      .service-group {
        margin-top: 2.2rem;
      }

      .service-group:first-of-type {
        margin-top: 1.6rem;
      }

      .service-group > h2 {
        font-family: "Sora", sans-serif;
        color: var(--brand-strong);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin: 0 0 0.85rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--line);
      }

      .card {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--line);
        background: var(--surface);
        border-radius: 0.95rem;
        padding: 1rem;
      }

      /* The service icon is a watermark bleeding off the bottom-right corner rather than a small
         inline mark. Size is set as a share of card height so the shorter pricing cards and the
         taller service cards get a proportional mark instead of one fixed size that suits neither.
         Opacity is deliberately low: at 0.05 body text clears WCAG AA comfortably (~5:1 even over
         the darkest part of the page gradient). Going much past 0.07 starts eating that margin. */
      .card .icon {
        position: absolute;
        right: -0.5rem;
        bottom: -0.6rem;
        /* astro-icon emits the svg at width/height="1em", so font-size is the fallback size if
           the aspect-ratio sizing below doesn't apply. */
        font-size: 9rem;
        height: 82%;
        width: auto;
        aspect-ratio: 1 / 1;
        margin: 0;
        color: var(--brand-strong);
        opacity: 0.05;
        z-index: 0;
        pointer-events: none;
      }

      .card h3,
      .card p,
      .card ul {
        position: relative;
        z-index: 1;
      }

      .card h3 {
        margin: 0 0 0.45rem;
        font-size: 1.06rem;
        color: var(--brand-strong);
        font-family: "Sora", sans-serif;
      }

      .card p {
        margin: 0;
        color: var(--ink-soft);
        line-height: 1.55;
      }

      .card ul {
        margin: 0.55rem 0 0 1rem;
        padding: 0;
        color: var(--ink-soft);
      }

      .card li {
        margin: 0 0 0.3rem;
      }

      /* Real portfolio screenshots, reused from /work at their native 1180x615. They break the
         run of text between the service cards and pricing, and are below the fold — keep them
         lazy with explicit dimensions so LCP and CLS are unaffected. */
      .proof {
        margin-top: 3rem;
      }

      .proof > h2 {
        font-family: "Sora", sans-serif;
        color: var(--brand-strong);
        font-size: clamp(1.4rem, 2vw, 1.8rem);
        margin: 0 0 0.5rem;
      }

      .proof-grid {
        margin-top: 1.2rem;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
      }

      .proof-card {
        display: block;
        border: 1px solid var(--line);
        background: var(--surface);
        border-radius: 0.95rem;
        overflow: hidden;
        text-decoration: none;
        transition: transform 160ms ease, box-shadow 160ms ease;
      }

      .proof-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 24px rgba(18, 45, 69, 0.16);
      }

      .proof-card img {
        width: 100%;
        height: auto;
        aspect-ratio: 1180 / 615;
        object-fit: cover;
        object-position: top;
        display: block;
      }

      .proof-name {
        display: block;
        padding: 0.7rem 0.9rem;
        font-family: "Sora", sans-serif;
        font-weight: 600;
        color: var(--brand-strong);
      }

      .proof-more {
        margin-top: 1rem;
        color: var(--ink-soft);
      }

      @media (max-width: 920px) {
        .proof-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 640px) {
        .proof-grid {
          grid-template-columns: 1fr;
        }
      }

      .pricing {
        margin-top: 3rem;
      }

      .pricing .lead {
        margin-bottom: 0;
      }

      .pricing-grid {
        margin-top: 1.2rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .pricing-note {
        margin-top: 1.2rem;
        color: var(--ink-soft);
        max-width: 70ch;
      }

      @media (max-width: 920px) {
        .pricing-grid {
          grid-template-columns: 1fr;
        }
      }

      .cta-banner {
        position: relative;
        width: 100vw;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        margin-top: 3rem;
        padding: 4rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.2rem;
        background: linear-gradient(120deg, #0e2133 0%, #1a3d5c 60%, #0e2133 100%);
        color: #fff;
      }

      .cta-banner h2 {
        margin: 0;
        font-family: "Sora", sans-serif;
        font-size: clamp(1.5rem, 2.8vw, 2.2rem);
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.01em;
      }

      .cta-banner p {
        margin: 0;
        color: rgba(220, 237, 255, 0.85);
        max-width: 54ch;
        line-height: 1.65;
        font-size: 1.05rem;
      }

      .cta-banner .button {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.8rem 1.5rem;
        border-radius: 0.75rem;
        font-family: "Sora", sans-serif;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        background: #fff;
        color: #1a3d5c;
        border: none;
        margin-top: 0.4rem;
      }

      .cta-banner .button .icon {
        width: 1rem;
        height: 1rem;
      }

      .site-footer {
        margin-top: 2rem;
      }

      @media (max-width: 920px) {
        .grid {
          grid-template-columns: 1fr;
        }

        .header-overlay {
          padding: 2rem 1.2rem 2rem 1.2rem;
          align-items: flex-start;
        }

        .header-overlay .hero-title {
          font-size: 2rem;
        }

        .header-overlay .hero-desc {
          font-size: 1rem;
        }
      }
    </style>
  </Fragment>

  <SiteHeader active="services" />

  <div class="header-hero">
    <img src="/services-header.webp" alt="Stone Dragon Media digital services — web design, development, marketing, and consulting" />
    <div class="header-overlay">
      <span class="about-label">SERVICES</span>
      <span class="hero-title">Our Solutions</span>
      <span class="hero-desc">
        End-to-end digital services including web design, application development, marketing, hosting, branding, and consulting.
      </span>
    </div>
  </div>

  <main class="page">
    <h1>Web Design &amp; Development Services in Sandusky, Ohio</h1>
    <p class="lead">Stone Dragon Media offers end-to-end digital services from strategy through launch and long-term support, including website solutions built for speed and reliability. Based in Sandusky, Ohio, we work in person across Erie County and northern Ohio, from Toledo in the west to Cleveland in the east, and remotely with clients anywhere.</p>
    <section class="service-group">
      <h2>Design &amp; Development</h2>
      <div class="grid">
        <article class="card" id="custom-web-solutions">
          <Icon class="icon" name="lucide:layout-template" aria-hidden="true" />
          <h3>Custom Web Solutions</h3>
          <p>Custom websites and web systems built to communicate value, drive action, and stay lightning fast.</p>
          <ul>
            <li>eCommerce and informational websites</li>
            <li>Landing pages and microsites</li>
            <li>Platform and third-party integrations</li>
            <li>Website redesigns and migrations</li>
          </ul>
        </article>
        <article class="card" id="application-development">
          <Icon class="icon" name="lucide:cpu" aria-hidden="true" />
          <h3>Custom Application Development</h3>
          <p>Tailored software solutions built around your workflow, not the other way around.</p>
          <ul>
            <li>Internal tools and dashboards</li>
            <li>Customer and client portals</li>
            <li>Process and workflow automation</li>
            <li>API development, integrations, and database design</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="service-group">
      <h2>Marketing &amp; Analytics</h2>
      <div class="grid">
        <article class="card" id="marketing">
          <Icon class="icon" name="lucide:megaphone" aria-hidden="true" />
          <h3>Marketing</h3>
          <p>Data-driven campaigns that put your business in front of the right audience at the right time.</p>
          <ul>
            <li>Search Engine Optimization (SEO)</li>
            <li>Pay Per Click (PPC) management</li>
            <li>Social media, email, and text message marketing</li>
            <li>Content strategy and copywriting</li>
          </ul>
        </article>
        <article class="card" id="analytics-reporting">
          <Icon class="icon" name="lucide:bar-chart-2" aria-hidden="true" />
          <h3>Analytics &amp; Reporting</h3>
          <p>Turn your data into decisions with clear, actionable insight into how your digital presence is performing.</p>
          <ul>
            <li>Google Analytics setup and configuration</li>
            <li>Conversion tracking and goal setup</li>
            <li>Custom reporting dashboards</li>
            <li>Performance audits</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="service-group">
      <h2>Hosting &amp; Security</h2>
      <div class="grid">
        <article class="card" id="hosting-infrastructure">
          <Icon class="icon" name="lucide:server" aria-hidden="true" />
          <h3>Hosting &amp; Infrastructure</h3>
          <p>Reliable, secure hosting environments configured for performance and peace of mind.</p>
          <ul>
            <li>Domain registration and SSL management</li>
            <li>Cloud and VPS server setup</li>
            <li>Hosting migration and troubleshooting</li>
            <li>Performance optimization, backup, and recovery planning</li>
          </ul>
        </article>
        <article class="card" id="security-maintenance">
          <Icon class="icon" name="lucide:shield" aria-hidden="true" />
          <h3>Security &amp; Maintenance</h3>
          <p>Proactive care to keep your site secure, up to date, and running smoothly long after launch.</p>
          <ul>
            <li>Security hardening and monitoring</li>
            <li>Software and plugin updates</li>
            <li>Uptime monitoring and vulnerability assessments</li>
            <li>Ongoing site maintenance plans</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="service-group">
      <h2>Branding &amp; Consulting</h2>
      <div class="grid">
        <article class="card" id="branding-design">
          <Icon class="icon" name="lucide:palette" aria-hidden="true" />
          <h3>Branding &amp; Design</h3>
          <p>A cohesive visual identity that communicates who you are and builds trust with your audience.</p>
          <ul>
            <li>Logo design and brand mark creation</li>
            <li>Brand style guide development</li>
            <li>Color palette and typography systems</li>
            <li>Brand consultation, print, and digital asset design</li>
          </ul>
        </article>
        <article class="card" id="consulting-strategy">
          <Icon class="icon" name="lucide:compass" aria-hidden="true" />
          <h3>Consulting &amp; Strategy</h3>
          <p>Expert guidance to help you make confident decisions about technology, process, and digital growth.</p>
          <ul>
            <li>Technology and platform selection</li>
            <li>Digital transformation planning</li>
            <li>Data migration and architecture</li>
            <li>IT process improvement and project roadmapping</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="proof">
      <h2>Recent Work</h2>
      <p class="lead">A few of the projects behind those services.</p>
      <div class="proof-grid">
        <a class="proof-card" href="/work/#simon-rook">
          <img src="/work/simonrook.webp" alt="Simon Rook author website" loading="lazy" width="1180" height="615" />
          <span class="proof-name">Simon Rook</span>
        </a>
        <a class="proof-card" href="/work/#dorian-black">
          <img src="/work/dorianblack.webp" alt="Dorian Black synth-pop artist website" loading="lazy" width="1180" height="615" />
          <span class="proof-name">Dorian Black</span>
        </a>
        <a class="proof-card" href="/work/#pneumaris">
          <img src="/work/pneumaris.webp" alt="Pneumaris band website" loading="lazy" width="1180" height="615" />
          <span class="proof-name">Pneumaris</span>
        </a>
        <a class="proof-card" href="/work/#tagstash">
          <img src="/work/tagstash.webp" alt="Tagstash bookmarking tool" loading="lazy" width="1180" height="615" />
          <span class="proof-name">Tagstash</span>
        </a>
      </div>
      <p class="proof-more">See the full breakdown of each build on our <a href="/work/">work page</a>.</p>
    </section>

    <section class="pricing">
      <h2>How Much Does a Website Cost?</h2>
      <p class="lead">
        Every business is different, so we don&rsquo;t work off a fixed price sheet. We build custom
        pricing and payment arrangements around your budget, timeline, and goals &mdash; not the
        other way around.
      </p>
      <div class="pricing-grid">
        <article class="card">
          <Icon class="icon" name="lucide:badge-dollar-sign" aria-hidden="true" />
          <h3>One-Time Development</h3>
          <p>
            Pay a single project cost, and once it&rsquo;s settled the code is fully yours &mdash; a
            complete license transfer with no ongoing fees, subscriptions, or dependency on us to
            keep running.
          </p>
        </article>
        <article class="card">
          <Icon class="icon" name="lucide:calendar-clock" aria-hidden="true" />
          <h3>Managed, Low Upfront</h3>
          <p>
            Get a professionally built and fully managed site or application with little to no
            money down, with the cost split into affordable monthly or yearly payments instead.
          </p>
        </article>
        <article class="card">
          <Icon class="icon" name="lucide:puzzle" aria-hidden="true" />
          <h3>Custom Arrangements</h3>
          <p>
            Need a mix of both? We&rsquo;ll structure a plan that blends ownership, hosting, and
            ongoing support in whatever combination makes the most sense for your business.
          </p>
        </article>
      </div>
      <p class="pricing-note">
        Not sure which of these fits? Reach out for a free, no-obligation quote and we&rsquo;ll
        walk through the options together.
      </p>
    </section>

    <div class="cta-banner">
      <h2>Ready to start your next project?</h2>
      <p>Whether you need a new website, a custom application, or a full digital strategy, we are here to help. Let us talk through your goals and build something great together.</p>
      <a class="button" href="/contact/">
        <Icon class="icon" name="lucide:send" aria-hidden="true" />
        Get in Touch
      </a>
    </div>
  </main>

  <div class="footer-wrap">
    <SiteFooter />
  </div>
</BaseLayout>
