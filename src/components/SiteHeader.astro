---
import { Icon } from "astro-icon/components";
import SocialLinks from "./SocialLinks.astro";
import { serviceCategoryLinks } from "../lib/services";

interface Props {
	active?: "home" | "about" | "services" | "work" | "products" | "contact" | "login";
	showCta?: boolean;
}

const { active = "home", showCta = false } = Astro.props;

// Trailing slash normalised so the dropdown item for the page you are on can be marked current.
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<a class="skip-link" href="#main-content">Skip to main content</a>

<header class="site-head">
	<div class="site-utility">
		<div class="site-utility-inner">
			<div class="site-utility-contact">
				<a class="site-utility-phone" href="tel:+15674500960">
					<Icon class="icon" name="lucide:phone" aria-hidden="true" />
					(567) 450-0960
				</a>
				<span class="site-utility-loc">
					<Icon class="icon" name="lucide:map-pin" aria-hidden="true" />
					Sandusky, OH
				</span>
			</div>
			<SocialLinks class="utility-social" />
		</div>
	</div>
	<div class="site-head-inner">
		<div class="site-head-bar">
			<a class="site-brand" href="/">
				<img class="brand-logo" src="/logo-cropped.png" alt="Stone Dragon Media logo" loading="eager" decoding="async" />
			</a>
			<button
				class="nav-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="site-nav-panel"
				aria-label="Toggle navigation menu"
			>
				<Icon class="icon icon-open" name="lucide:menu" aria-hidden="true" />
				<Icon class="icon icon-close" name="lucide:x" aria-hidden="true" />
			</button>
		</div>
		<div class="site-nav-panel" id="site-nav-panel">
			<nav class="site-nav" aria-label="Primary">
				<a class={active === "home" ? "active" : undefined} href="/" aria-current={currentPath === "/" ? "page" : undefined}>Home</a>
				<a class={active === "about" ? "active" : undefined} href="/about/" aria-current={currentPath === "/about/" ? "page" : undefined}>About</a>
				<div class="nav-group">
					<a class={active === "services" ? "active" : undefined} href="/services/" aria-current={currentPath === "/services/" ? "page" : undefined}>Services</a>
					<button
						class="nav-sub-toggle"
						type="button"
						aria-expanded="false"
						aria-controls="nav-services-menu"
						aria-label="Toggle services submenu"
					>
						<Icon class="icon" name="lucide:chevron-down" aria-hidden="true" />
					</button>
					<ul class="nav-dropdown" id="nav-services-menu">
						{serviceCategoryLinks.map((item) => (
							<li>
								<a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a>
							</li>
						))}
					</ul>
				</div>
				<a class={active === "work" ? "active" : undefined} href="/work/" aria-current={currentPath === "/work/" ? "page" : undefined}>Our Work</a>
				<a class={active === "products" ? "active" : undefined} href="/products/" aria-current={currentPath === "/products/" ? "page" : undefined}>Products</a>
				<a class={active === "contact" ? "active" : undefined} href="/contact/" aria-current={currentPath === "/contact/" ? "page" : undefined}>Contact</a>
				<a class={`nav-login${active === "login" ? " active" : ""}`} href="/login/" aria-current={currentPath === "/login/" ? "page" : undefined}>
					<Icon class="icon" name="lucide:lock" aria-hidden="true" />
					Client Login
				</a>
			</nav>
			{showCta && (
				<a class="button button-secondary" href="/contact/">
					<Icon class="icon" name="lucide:send" aria-hidden="true" />
					Start a Project
				</a>
			)}
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector(".nav-toggle") as HTMLButtonElement | null;
	const panel = document.querySelector<HTMLElement>(".site-nav-panel");
	const navGroup = document.querySelector(".nav-group") as HTMLElement | null;
	const subToggle = navGroup?.querySelector(".nav-sub-toggle") as HTMLButtonElement | null;
	const mobileNav = window.matchMedia("(max-width: 920px)");
	const setSubmenuOpen = (open: boolean) => {
		subToggle?.setAttribute("aria-expanded", String(open));
	};
	const closePanel = () => {
		toggle?.setAttribute("aria-expanded", "false");
		panel?.classList.remove("is-open");
		setSubmenuOpen(false);
	};

	if (toggle && panel) {
		toggle.addEventListener("click", () => {
			const isOpen = toggle.getAttribute("aria-expanded") === "true";
			if (isOpen) {
				closePanel();
			} else {
				toggle.setAttribute("aria-expanded", "true");
				panel.classList.add("is-open");
			}
		});

		panel.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", closePanel);
		});
	}

	// One expanded state controls both visibility and the chevron. Only a new pointer/focus
	// entry or explicit button activation reopens a dismissed submenu.
	if (navGroup && subToggle) {
		navGroup.addEventListener("pointerenter", (event) => {
			if (mobileNav.matches || event.pointerType === "touch") return;
			setSubmenuOpen(true);
		});
		navGroup.addEventListener("pointerleave", () => {
			if (!navGroup.contains(document.activeElement)) setSubmenuOpen(false);
		});
		navGroup.addEventListener("focusin", (event) => {
			if (!mobileNav.matches && (event.target as HTMLElement).matches(":focus-visible")
				&& !navGroup.contains(event.relatedTarget as Node | null)) {
				setSubmenuOpen(true);
			}
		});
		navGroup.addEventListener("focusout", (event) => {
			// Browsers may blur a now-hidden desktop link before the breakpoint change event.
			if (!event.relatedTarget && mobileNav.matches && !panel?.classList.contains("is-open")) {
				toggle?.focus();
			}
			if (!navGroup.contains(event.relatedTarget as Node | null)) setSubmenuOpen(false);
		});

		subToggle.addEventListener("click", () => {
			setSubmenuOpen(subToggle.getAttribute("aria-expanded") !== "true");
		});

		document.addEventListener("click", (event) => {
			if (!navGroup.contains(event.target as Node)) {
				setSubmenuOpen(false);
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && subToggle.getAttribute("aria-expanded") === "true") {
				event.preventDefault();
				setSubmenuOpen(false);
				// Hover-only dismissal must not pull keyboard focus away from the page.
				if (navGroup.contains(document.activeElement)) subToggle.focus();
			} else if (event.key === "Escape" && mobileNav.matches && panel?.classList.contains("is-open")) {
				closePanel();
				toggle?.focus();
			}
		});

		mobileNav.addEventListener("change", () => {
			// Don't leave focus in a submenu or navigation panel that is about to be hidden.
			if (mobileNav.matches && panel?.contains(document.activeElement)) {
				toggle?.focus();
			} else if (!mobileNav.matches && document.activeElement === toggle) {
				panel?.querySelector("a")?.focus();
			} else if (navGroup.querySelector(".nav-dropdown")?.contains(document.activeElement)) {
				subToggle.focus();
			}
			closePanel();
		});
	}
</script>
