---
import { Icon } from "astro-icon/components";
import SocialLinks from "./SocialLinks.astro";
import { serviceCategoryLinks } from "../lib/services";

interface Props {
	active?: "home" | "about" | "services" | "work" | "products" | "contact" | "login";
	showCta?: boolean;
}

const { active = "home", showCta = false } = Astro.props;

// Trailing slash normalised so the dropdown item for the page you are on can be marked current.
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<a class="skip-link" href="#main-content">Skip to main content</a>

<header class="site-head">
	<div class="site-utility">
		<div class="site-utility-inner">
			<div class="site-utility-contact">
				<a class="site-utility-phone" href="tel:+15674500960">
					<Icon class="icon" name="lucide:phone" aria-hidden="true" />
					(567) 450-0960
				</a>
				<span class="site-utility-loc">
					<Icon class="icon" name="lucide:map-pin" aria-hidden="true" />
					Sandusky, OH
				</span>
			</div>
			<SocialLinks class="utility-social" />
		</div>
	</div>
	<div class="site-head-inner">
		<div class="site-head-bar">
			<a class="site-brand" href="/">
				<img class="brand-logo" src="/logo-cropped.png" alt="Stone Dragon Media logo" loading="eager" decoding="async" />
			</a>
			<button
				class="nav-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="site-nav-panel"
				aria-label="Toggle navigation menu"
			>
				<Icon class="icon icon-open" name="lucide:menu" aria-hidden="true" />
				<Icon class="icon icon-close" name="lucide:x" aria-hidden="true" />
			</button>
		</div>
		<div class="site-nav-panel" id="site-nav-panel">
			<nav class="site-nav" aria-label="Primary">
				<a class={active === "home" ? "active" : undefined} href="/">Home</a>
				<a class={active === "about" ? "active" : undefined} href="/about/">About</a>
				<div class="nav-group">
					<a class={active === "services" ? "active" : undefined} href="/services/">Services</a>
					<button
						class="nav-sub-toggle"
						type="button"
						aria-expanded="false"
						aria-controls="nav-services-menu"
						aria-label="Toggle services submenu"
					>
						<Icon class="icon" name="lucide:chevron-down" aria-hidden="true" />
					</button>
					<ul class="nav-dropdown" id="nav-services-menu">
						{serviceCategoryLinks.map((item) => (
							<li>
								<a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a>
							</li>
						))}
					</ul>
				</div>
				<a class={active === "work" ? "active" : undefined} href="/work/">Our Work</a>
				<a class={active === "products" ? "active" : undefined} href="/products/">Products</a>
				<a class={active === "contact" ? "active" : undefined} href="/contact/">Contact</a>
				<a class={`nav-login${active === "login" ? " active" : ""}`} href="/login/">
					<Icon class="icon" name="lucide:lock" aria-hidden="true" />
					Client Login
				</a>
			</nav>
			{showCta && (
				<a class="button button-secondary" href="/contact/">
					<Icon class="icon" name="lucide:send" aria-hidden="true" />
					Start a Project
				</a>
			)}
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
	const panel = document.querySelector<HTMLElement>(".site-nav-panel");

	if (toggle && panel) {
		toggle.addEventListener("click", () => {
			const isOpen = toggle.getAttribute("aria-expanded") === "true";
			toggle.setAttribute("aria-expanded", String(!isOpen));
			panel.classList.toggle("is-open", !isOpen);
		});

		panel.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => {
				toggle.setAttribute("aria-expanded", "false");
				panel.classList.remove("is-open");
			});
		});
	}

	// Services submenu. CSS already opens it on hover and on keyboard focus; this covers the
	// chevron being clicked or tapped, which is the only way in on the stacked mobile nav.
	const navGroup = document.querySelector(".nav-group") as HTMLElement | null;
	const subToggle = navGroup?.querySelector(".nav-sub-toggle") as HTMLElement | null;

	if (navGroup && subToggle) {
		const setOpen = (open: boolean) => {
			subToggle.setAttribute("aria-expanded", String(open));
			navGroup.classList.toggle("is-open", open);
		};

		subToggle.addEventListener("click", () => {
			setOpen(subToggle.getAttribute("aria-expanded") !== "true");
		});

		document.addEventListener("click", (event) => {
			if (!navGroup.contains(event.target as Node)) {
				setOpen(false);
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && subToggle.getAttribute("aria-expanded") === "true") {
				setOpen(false);
				subToggle.focus();
			}
		});

		navGroup.querySelectorAll(".nav-dropdown a").forEach((link) => {
			link.addEventListener("click", () => setOpen(false));
		});
	}
</script>
