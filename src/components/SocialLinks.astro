---
import { Icon } from "astro-icon/components";
import { socialProfiles } from "../lib/social";

/**
 * The business's social profile icons, rendered from `src/lib/social.ts`.
 * Used in the header utility bar and the footer, so it's a list rather than a
 * <nav> — two identically-labelled nav landmarks on one page is a duplicate
 * landmark. The icons are aria-hidden; each link carries the accessible name.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<ul class:list={["social-links", className]}>
	{socialProfiles.map((profile) => (
		<li>
			<a
				href={profile.url}
				target="_blank"
				rel="me noopener"
				aria-label={`Stone Dragon Media on ${profile.name}`}
			>
				<Icon name={profile.icon} aria-hidden="true" />
			</a>
		</li>
	))}
</ul>
